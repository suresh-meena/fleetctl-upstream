PRIVATE_DIR_MODE = 0o700
PRIVATE_FILE_MODE = 0o600
STATE_DIR_MODE = 0o700
DEFAULT_PASS_PREFIX = "infra/fleet"
DEFAULT_SCRIPT_REMOTE_ROOT = ".local/state/fleet/scripts"
DEFAULT_SYNC_EXCLUDES = [
    ".direnv/",
    ".env",
    ".env.local",
    ".git/",
    ".mypy_cache/",
    ".nox/",
    ".pytest_cache/",
