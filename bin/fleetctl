# `command` runs `secret_ref` and reads TOML off its stdout.  It exists for the
# field that will not hold still -- a cloud box whose address changes on every
# start -- and it keeps that knowledge in a script the operator already has
# rather than making fleetctl learn one provider's API and then the next one's.
SECRET_BACKENDS = ("file", "pass", "inline", "command")
PROTOCOL_KINDS = ("direct", "slurm")
GPU_REQUEST_MODES = ("none", "gpus", "gres")
GPU_VENDORS = ("nvidia", "amd", "intel")
# How a declared site fact came to be known, worst to best.  The distinction is
# operational, not bookkeeping: a cluster manual that contradicts itself is a
# real thing to have read, and a partition limit a job actually hit is a
# different kind of claim from one an example script implied.  `preflight`
# labels its findings with these, so a refusal can be argued with on the right
# grounds -- and `doctor` can say which "verified" facts have gone stale.
EVIDENCE_CLASSES = (
    "verified-by-run",
    "verified-live",
    "documented",
    "document-conflict",
    "inferred",
)
AUTH_MODES = ("key", "password")
STRICT_HOST_KEY_MODES = ("yes", "no", "off", "ask", "accept-new")

# Keys that used to mean something and no longer do.  Four fields described one
# property -- "does compute here go through a scheduler" -- and disagreed with
# each other; `role` and `submit_command` now answer it once each.  They stay
# *accepted* so an unmigrated fleet keeps loading, but nothing reads them, and
# `doctor` names every file still carrying one.  Tolerating a key is a decision,
# so it is written down here rather than hidden as a stray entry in a key set.
DEPRECATED_TARGET_KEYS: dict[str, str] = {
    "scheduler": "what may run here is decided by `role`; `protocol` is required",
    "transport": (
        "there was one value, `ssh`, and nothing ever branched on it. A second "
        "transport would have to change how commands, copies and control sockets "
        "are built, none of which a key in a target file could reach"
    ),
    "ssh_host_alias": (
        "it never reached an ssh invocation, and could not: a fleet connection is "
        "built from the secret and deliberately ignores `~/.ssh/config`, which is "
        "what `IdentitiesOnly` and a private `known_hosts` are for. A real `Host` "
        "alias is expressible as `[ssh_option]` in the secret"
    ),
    "metadata": (
        "a free-form table nothing read. The two things people put in it are "
        "already modelled by something that acts on them: `tags` to group hosts, "
        "`[capabilities]` to describe the hardware"
    ),
}
DEPRECATED_PROTOCOL_KEYS: dict[str, str] = {
    "scheduler_required": "the role matrix decides this for every verb",
    "allow_login_exec": "the role matrix decides this; pass --admin per command",
    "smoke_gpu_probe": (
        "whether a host has a GPU is a fact about the host, not about the site "
        'protocol shared by all of them; declare `gpu_count` under the target\'s '
        "`[capabilities]` and `smoke` follows it"
    ),
    "job_runtime": (
        "nothing ever read it, and a second runtime dimension is the wrong shape "
        "anyway: how work is invoked belongs to the profile that invokes it, so a "
        'container is an `interpreter` or a `submit_command` beginning '
        '["apptainer", "exec", ...] -- one place, and one that `--dry-run` prints'
    ),
}
DEPRECATED_POOL_KEYS: dict[str, str] = {
    "strategy": (
        "`ordered` was the only value left. The one it replaced, `random`, was "
        "re-rolled on every call, so `sync push` landed the code on one member "
        "and the `submit` after it queued the job on another. Selection takes the "
        "first enabled member, and `--require`/`--fit` are how you ask for a "
        "different one -- repeatably, and for a stated reason"
    ),
    "default_profile": (
        "profile resolution never saw the pool, so this was unreachable; set it "
        "on the target, the protocol, or the project binding"
    ),
}
DEPRECATED_PROFILE_KEYS: dict[str, str] = {
    "kind": "derived from whether the profile defines `submit_command`",
}
DEPRECATED_SECRET_KEYS: dict[str, str] = {
    "proxy_jump": (
        "how a host is reached is inventory, not a credential; declare "
        '`reach = ["direct", "via:<bridge>"]` on the target instead, which is '
        "validated at load time, reported by `list --format topology`, and "
        "carries the bridge's own fleet SSH settings. A waypoint that is not "
        "itself a fleet target is still expressible as `[ssh_option] ProxyJump`"
    ),
}
DEPRECATED_CONFIG_DEFAULTS_KEYS: dict[str, str] = {
    "redact_sensitive_output": (
        "nothing ever read it; `show --secret` redacts by default and "
        "`--sensitive` asks for the real values one command at a time, which "
        "beats a global switch that silently changes what every command prints"
    ),
}


def reject_unknown_keys(
    raw: dict[str, Any],
    known: Iterable[str],
    *,
    what: str,
    source: Path | None = None,
    guidance: dict[str, str] | None = None,
    deprecated: dict[str, str] | None = None,
) -> None:
    """Fail on any key the loader would otherwise ignore.

    DEPRECATED keys are accepted and ignored -- never suggested as a correction,
    because steering a typo towards a dead field is worse than no suggestion.
    """
    known_keys = sorted(known)
    tolerated = set(known_keys) | set(deprecated or ())
    unknown = sorted(key for key in raw if key not in tolerated)
    if not unknown:
        return
    hints: list[str] = []
    for key in unknown:
        if guidance and key in guidance:
            hints.append(f"`{key}` ({guidance[key]})")
            continue
        close = difflib.get_close_matches(key, known_keys, n=1, cutoff=0.7)
        suggestion = f" (did you mean `{close[0]}`?)" if close else ""
        hints.append(f"`{key}`{suggestion}")
    where = f" in {source}" if source is not None else ""
    plural = "keys" if len(unknown) > 1 else "key"
    raise FleetError(
        f"unrecognised {plural} in {what}{where}: {'; '.join(hints)}. "
        f"Known keys: {', '.join(known_keys)}."
    )


def check_vocabulary(
    value: str,
    allowed: tuple[str, ...],
    *,
    what: str,
    key: str,
    source: Path | None = None,
) -> str:
    """Return VALUE when it is a member of ALLOWED, else fail."""
    if value in allowed:
        return value
    close = difflib.get_close_matches(value, list(allowed), n=1, cutoff=0.6)
    suggestion = f" Did you mean {close[0]!r}?" if close else ""
    where = f" in {source}" if source is not None else ""
    raise FleetError(
        f"invalid `{key}` for {what}{where}: {value!r} is not one of "
        f"{', '.join(repr(item) for item in allowed)}.{suggestion}"
    )


def check_version(
    raw: dict[str, Any],
    *,
    what: str,
    source: Path | None = None,
) -> None:
    """Reject a config file written for a different schema generation."""
    if "version" not in raw:
        return
    version = raw["version"]
    if version != CONFIG_VERSION:
        where = f" in {source}" if source is not None else ""
        raise FleetError(
            f"unsupported `version` for {what}{where}: {version!r}; this "
            f"fleetctl understands version {CONFIG_VERSION}"
        )


def check_table(value: Any, *, what: str, source: Path | None = None) -> dict[str, Any]:
    """Return VALUE as a TOML table or fail with a readable message."""
    if not isinstance(value, dict):
        where = f" in {source}" if source is not None else ""
        raise FleetError(f"{what}{where} must be a table, not {type(value).__name__}")
    return value


def validate_config_file(raw: dict[str, Any], *, source: Path) -> None:
    """Validate the top-level config.toml."""
    check_version(raw, what="fleet config", source=source)
    reject_unknown_keys(raw, CONFIG_KEYS, what="fleet config", source=source)
    defaults = check_table(
        raw.get("defaults", {}), what="`defaults`", source=source
    )
    reject_unknown_keys(
        defaults,
        CONFIG_DEFAULTS_KEYS,
        what="fleet config `[defaults]`",
        source=source,
        deprecated=DEPRECATED_CONFIG_DEFAULTS_KEYS,
    )
    ssh_section = check_table(raw.get("ssh", {}), what="`ssh`", source=source)
    reject_unknown_keys(
        ssh_section, CONFIG_SSH_KEYS, what="fleet config `[ssh]`", source=source
    )
    strict = optional_str(ssh_section.get("strict_host_key_checking"))
    if strict is not None:
        check_vocabulary(
            strict,
            STRICT_HOST_KEY_MODES,
            what="fleet config `[ssh]`",
            key="strict_host_key_checking",
            source=source,
        )


def load_toml_file(path: Path, *, default: Any | None = None) -> dict[str, Any]:
    """Load PATH as TOML or return DEFAULT when missing."""
    if not path.exists():
        if default is None:
            raise FleetError(f"missing required config file: {path}")
        return default
    try:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    except tomllib.TOMLDecodeError as exc:
        raise FleetError(f"invalid TOML in {path}: {exc}") from exc
    return data


def load_records_from_dir(
    path: Path,
    *,
    kind: str = "record",
) -> list[tuple[str, dict[str, Any], Path]]:
    """Read every TOML file in PATH and return (name, raw, source_path)."""
    if not path.exists():
        return []
    records: list[tuple[str, dict[str, Any], Path]] = []
    seen: dict[str, Path] = {}
    for entry in sorted(path.glob("*.toml")):
        raw = load_toml_file(entry)
        name = str(raw.get("name") or entry.stem)
        # The record name, not the filename, is the key every loader builds its
        # dict on, so two files claiming one name used to mean the
        # alphabetically later file silently won.  That is how a target gets
        # edited in one file and resolved from another.
        if name in seen:
            raise FleetError(
                f"duplicate {kind} name {name!r}: declared in both "
                f"{seen[name].name} and {entry.name} under {path}. Names are "
                "how fleetctl identifies records, so exactly one file may "
                "claim each one."
            )
        seen[name] = entry
        records.append((name, raw, entry))
    return records


TARGET_FILE_WARNINGS: dict[str, str] = {
    "remote_root": "project landing strips belong in project bindings, not targets",
    "host": "sensitive connection material belongs in secret records",
    "user": "sensitive connection material belongs in secret records",
    "port": "sensitive connection material belongs in secret records",
    "password": "sensitive connection material belongs in secret records",
    "identity_file": "sensitive connection material belongs in secret records",
}


def load_targets(path: Path) -> dict[str, TargetRecord]:
    """Load target metadata files."""
    targets: dict[str, TargetRecord] = {}
    for name, raw, source in load_records_from_dir(path, kind="target"):
        what = f"target {name!r}"
        check_version(raw, what=what, source=source)
        reject_unknown_keys(
            raw,
            TARGET_KEYS,
            what=what,
            source=source,
            guidance=TARGET_FILE_WARNINGS,
            deprecated=DEPRECATED_TARGET_KEYS,
        )
        # fleetctl used to fall back to `scheduler` when `protocol` was absent, so
        # the obvious way to add a Slurm box -- tags and no protocol -- produced a
        # direct target you could run training jobs on.  Naming the protocol is one
        # word and removes the guess entirely.
        if optional_str(raw.get("protocol")) is None:
            raise FleetError(
                f"{what} in {source} does not declare `protocol`. Name `direct` for "
                "a machine you run work on yourself, or the site's protocol for a "
                "scheduler surface; fleetctl no longer guesses."
            )
        target = TargetRecord(
            name=name,
            enabled=bool(raw.get("enabled", True)),
            role=(
                check_vocabulary(
                    str(raw["role"]), ROLES, what=what, key="role", source=source
                )
                if raw.get("role") is not None
                else None
            ),
            protocol=optional_str(raw.get("protocol")),
            reach=parse_reach(
                raw.get("reach", DEFAULT_REACH), what=what, source=source
            ),
            workdir=optional_str(raw.get("workdir")),
            tags=tuple(str(item) for item in raw.get("tags", [])),
            secret_backend=check_vocabulary(
                str(raw.get("secret_backend", "file")),
                SECRET_BACKENDS,
                what=what,
                key="secret_backend",
                source=source,
            ),
            secret_ref=optional_str(raw.get("secret_ref")),
            secret_inline=check_table(
                raw.get("secret", {}), what=f"`secret` for {what}", source=source
            ),
            capabilities=parse_capabilities(
                raw.get("capabilities", {}),
                what=f"`[capabilities]` for {what}",
                source=source,
            ),
            default_profile=optional_str(raw.get("default_profile")),
        )
        targets[target.name] = target
    return targets


def load_pools(path: Path) -> dict[str, PoolRecord]:
    """Load pool metadata files."""
    pools: dict[str, PoolRecord] = {}
    for name, raw, source in load_records_from_dir(path, kind="pool"):
        what = f"pool {name!r}"
        check_version(raw, what=what, source=source)
        reject_unknown_keys(
            raw,
            POOL_KEYS,
            what=what,
            source=source,
            deprecated=DEPRECATED_POOL_KEYS,
        )
        pool = PoolRecord(
            name=name,
            targets=tuple(str(item) for item in raw.get("targets", [])),
            match_tags=tuple(str(item) for item in raw.get("match_tags", [])),
        )
        if not pool.targets and not pool.match_tags:
            # `select_pool` treats "no members declared" as "every target",
            # which resolves to the alphabetically first host in the fleet --
            # today a Slurm controller.  A pool that names nobody is a config
            # mistake, never a request to match everything.
            raise FleetError(
                f"{what} in {source} declares neither `targets` nor "
                "`match_tags`, so it would match the entire fleet; list its "
                "members explicitly"
            )
        pools[pool.name] = pool
    return pools


def built_in_protocols() -> dict[str, ProtocolRecord]:
    """Return the built-in protocol catalog."""
    direct = ProtocolRecord(
        name="direct",
        kind="direct",
        description="Direct SSH execution on a host-level workdir.",
        default_profile="plain-ssh",
        gpu_request_mode="gres",
        native_batch_required=False,
    )
    slurm = ProtocolRecord(
        name="slurm",
        kind="slurm",
        description="Scheduler-backed login surface that submits compute via Slurm.",
        default_profile="slurm-batch",
        gpu_request_mode="gres",
        native_batch_required=False,
    )
    return {
        direct.name: direct,
        slurm.name: slurm,
    }


def parse_control_budget(
    raw: dict[str, Any], *, protocol_name: str, what: str, source: Path | None
) -> ControlBudgetRecord | None:
    """Parse one protocol's `[control_budget]` table, or None when it declares none."""
    table = raw.get("control_budget")
    if table is None:
        return None
    table = check_table(table, what=f"`[control_budget]` in {what}", source=source)
    reject_unknown_keys(
        table,
        CONTROL_BUDGET_KEYS,
        what=f"`[control_budget]` in {what}",
        source=source,
    )
    rates = {
        key: optional_float(table.get(key))
        for key in ("monitor_per_minute", "action_per_minute", "transfer_per_minute")
    }
    burst = optional_float(table.get("burst"))
    for key, value in rates.items():
        if value is not None and (not math.isfinite(value) or value <= 0):
            raise FleetError(f"`{key}` in `{what}` must be finite and greater than zero")
    if burst is not None and (not math.isfinite(burst) or burst <= 0):
        raise FleetError(f"`burst` in `{what}` must be finite and greater than zero")
    authority_url = optional_str(table.get("authority_url"))
    authority_token_file = optional_str(table.get("authority_token_file"))
    if bool(authority_url) != bool(authority_token_file):
        raise FleetError(
            f"`authority_url` and `authority_token_file` in `{what}` must be configured together"
        )
    return ControlBudgetRecord(
        monitor_per_minute=rates["monitor_per_minute"],
        action_per_minute=rates["action_per_minute"],
        transfer_per_minute=rates["transfer_per_minute"],
        burst=burst,
        canonical_cluster=optional_str(table.get("canonical_cluster")) or protocol_name,
        authority_url=authority_url,
        authority_token_file=authority_token_file,
    )


def load_protocols(path: Path) -> dict[str, ProtocolRecord]:
    """Load protocol definitions and merge them over the built-ins."""
    protocols = built_in_protocols()
    for name, raw, source in load_records_from_dir(path, kind="protocol"):
        what = f"protocol {name!r}"
        check_version(raw, what=what, source=source)
        reject_unknown_keys(
            raw,
            PROTOCOL_KEYS,
            what=what,
            source=source,
            deprecated=DEPRECATED_PROTOCOL_KEYS,
        )
        queues: list[QueueRecord] = []
        for item in raw.get("queue", []):
            if not isinstance(item, dict):
                raise FleetError(
                    f"invalid queue entry in protocol {name!r}; expected a table"
                )
            reject_unknown_keys(
                item, QUEUE_KEYS, what=f"a queue entry in {what}", source=source
            )
            partition = optional_str(item.get("partition")) or optional_str(
                item.get("name")
            )
            queue_name = optional_str(item.get("name")) or partition
            if not partition or not queue_name:
                raise FleetError(
                    f"protocol {name!r} has a queue without `name`/`partition`"
                )
            directives = item.get("directive", item.get("directives", []))
            if isinstance(directives, str):
                directive_values = (directives,)
            else:
                directive_values = tuple(str(value) for value in directives)
            notes = item.get("notes", [])
            if isinstance(notes, str):
                note_values = (notes,)
            else:
                note_values = tuple(str(value) for value in notes)
            queues.append(
                QueueRecord(
                    name=queue_name,
                    partition=partition,
                    default=bool(item.get("default", False)),
                    time_limit=optional_str(item.get("time_limit")),
                    gpus=optional_int(item.get("gpus")),
                    gres=optional_str(item.get("gres")),
                    cpus_per_task=optional_int(item.get("cpus_per_task")),
                    mem=optional_str(item.get("mem")),
                    account=optional_str(item.get("account")),
                    qos=optional_str(item.get("qos")),
                    constraint=optional_str(item.get("constraint")),
                    extra_directives=directive_values,
                    notes=note_values,
                    max_time=optional_str(item.get("max_time")),
                    allowed_accounts=optional_str_tuple(item.get("allowed_accounts")),
                    denied_accounts=optional_str_tuple(item.get("denied_accounts")),
                    required_qos=optional_str(item.get("required_qos")),
                    account_required=bool(item.get("account_required", False)),
                    gres_types=optional_str_tuple(item.get("gres_types")),
                    gpu_only=bool(item.get("gpu_only", False)),
                    nodes=optional_str_tuple(item.get("nodes")),
                    evidence=(
                        check_vocabulary(
                            str(item["evidence"]),
                            EVIDENCE_CLASSES,
                            what=f"queue {queue_name!r} in {what}",
                            key="evidence",
                            source=source,
                        )
                        if item.get("evidence") is not None
                        else None
                    ),
                    as_of=optional_str(item.get("as_of")),
                    capabilities=parse_capabilities(
                        item.get("capabilities", {}),
                        what=f"`[queue.capabilities]` for {queue_name!r} in {what}",
                        source=source,
                    ),
                )
            )
        docs = raw.get("docs", [])
        if isinstance(docs, str):
            doc_values = (docs,)
        else:
            doc_values = tuple(str(value) for value in docs)
        notes = raw.get("notes", [])
        if isinstance(notes, str):
            note_values = (notes,)
        else:
            note_values = tuple(str(value) for value in notes)
        kind = check_vocabulary(
            str(raw.get("kind", "direct")),
            PROTOCOL_KINDS,
            what=what,
            key="kind",
            source=source,
        )
        protocols[name] = ProtocolRecord(
            name=name,
            kind=kind,
            description=optional_str(raw.get("description")),
            default_profile=optional_str(raw.get("default_profile"))
            or ("slurm-batch" if kind == "slurm" else "plain-ssh"),
            gpu_request_mode=check_vocabulary(
                str(raw.get("gpu_request_mode", "gres")),
                GPU_REQUEST_MODES,
                what=what,
                key="gpu_request_mode",
                source=source,
            ),
            native_batch_required=bool(raw.get("native_batch_required", False)),
            job_output_dir=str(raw.get("job_output_dir", ".fleet/jobs")),
            docs=doc_values,
            notes=note_values,
            queues=tuple(queues),
            gpu_vendor=(
                check_vocabulary(
                    str(raw["gpu_vendor"]),
                    GPU_VENDORS,
                    what=what,
                    key="gpu_vendor",
                    source=source,
                )
                if raw.get("gpu_vendor") is not None
                else None
            ),
            preferred_storage=optional_str(raw.get("preferred_storage")),
            home_prefix=optional_str(raw.get("home_prefix")),
            storage_caveat=optional_str(raw.get("storage_caveat")),
            rule_prefix=optional_str(raw.get("rule_prefix")),
            control_budget=parse_control_budget(
                raw, protocol_name=name, what=what, source=source
            ),
        )
    return protocols


def validate_job_id_pattern(
    pattern: str | None,
    *,
    what: str,
    source: Path | None = None,
) -> str | None:
    """Compile a profile's job-id regex now rather than after a job is queued.

    The pattern is only applied to scheduler output, which happens *after*
    `sbatch` has already accepted the job.  An invalid regex there raises
    `re.error` at the one moment a traceback is unrecoverable: the allocation is
    running and its ID has just been discarded.  Compiling at load time makes
    that state unreachable.
    """
    if pattern is None:
        return None
    try:
        re.compile(pattern)
    except re.error as exc:
        where = f" in {source}" if source is not None else ""
        raise FleetError(
            f"invalid `job_id_pattern` for {what}{where}: {exc}"
        ) from exc
    return pattern


def load_profiles(path: Path) -> dict[str, ProfileRecord]:
    """Load execution profile files."""
    profiles: dict[str, ProfileRecord] = {}
    for name, raw, source in load_records_from_dir(path, kind="profile"):
        what = f"profile {name!r}"
        check_version(raw, what=what, source=source)
        reject_unknown_keys(
            raw,
            PROFILE_KEYS,
            what=what,
            source=source,
            deprecated=DEPRECATED_PROFILE_KEYS,
        )
        submit = tuple(str(item) for item in raw.get("submit_command", []))
        status = tuple(str(item) for item in raw.get("status_command", []))
        cancel = tuple(str(item) for item in raw.get("cancel_command", []))
        logs = tuple(str(item) for item in raw.get("logs_command", []))
        script = check_table(
            raw.get("script", {}), what=f"`[script]` for {what}", source=source
        )
        reject_unknown_keys(
            script, PROFILE_SCRIPT_KEYS, what=f"`[script]` for {what}", source=source
        )
        environment = check_table(
            raw.get("environment", {}),
            what=f"`[environment]` for {what}",
            source=source,
        )
        if isinstance(script, dict):
            interpreter = optional_str(script.get("interpreter"))
            remote_script_root = str(
                script.get("remote_script_root", DEFAULT_SCRIPT_REMOTE_ROOT)
            )
        else:
            interpreter = "/usr/bin/env bash"
            remote_script_root = DEFAULT_SCRIPT_REMOTE_ROOT
        profiles[name] = ProfileRecord(
            name=name,
            interpreter=interpreter,
            remote_script_root=remote_script_root,
            environment={str(key): str(value) for key, value in environment.items()},
            submit_command=submit,
            status_command=status,
            cancel_command=cancel,
            logs_command=logs,
            job_id_pattern=validate_job_id_pattern(
                optional_str(raw.get("job_id_pattern")), what=what, source=source
            ),
        )
    if "plain-ssh" not in profiles:
        profiles["plain-ssh"] = ProfileRecord(name="plain-ssh")
    return profiles


def load_projects(path: Path) -> list[ProjectBinding]:
    """Load local per-project defaults."""
    if not path.exists():
        return []
    raw = load_toml_file(path)
    check_version(raw, what="project bindings", source=path)
    reject_unknown_keys(raw, PROJECTS_FILE_KEYS, what="project bindings", source=path)
    bindings: list[ProjectBinding] = []
    for index, item in enumerate(raw.get("project", [])):
        item = check_table(item, what=f"`[[project]]` #{index + 1}", source=path)
        if "path" not in item:
            raise FleetError(
                f"`[[project]]` #{index + 1} in {path} has no `path`; a binding "
                "must name the local project directory it applies to"
            )
        what = f"project binding {str(item['path'])!r}"
        reject_unknown_keys(item, PROJECT_KEYS, what=what, source=path)
        target_roots = {}
        for entry in item.get("target_root", []):
            entry = check_table(
                entry, what=f"`[[project.target_root]]` for {what}", source=path
            )
            reject_unknown_keys(
                entry,
                PROJECT_TARGET_ROOT_KEYS,
                what=f"`[[project.target_root]]` for {what}",
                source=path,
            )
            target_name = optional_str(entry.get("target"))
            remote_root = optional_str(entry.get("remote_root"))
            if not target_name or not remote_root:
                raise FleetError(
                    f"`[[project.target_root]]` for {what} in {path} needs both "
                    "`target` and `remote_root`"
                )
            target_roots[target_name] = remote_root
        bindings.append(
            ProjectBinding(
                path=expand_local_path(str(item["path"])),
                default_target=optional_str(item.get("default_target")),
                default_pool=optional_str(item.get("default_pool")),
                default_profile=optional_str(item.get("default_profile")),
                remote_root=optional_str(item.get("remote_root")),
                remote_roots_by_target=target_roots,
                sync_excludes=tuple(
                    str(entry) for entry in item.get("sync_excludes", [])
                ),
            )
        )
    return bindings


def target_schema_warnings(path: Path) -> list[str]:
    """Report misplaced fields in target metadata files."""
    warnings: list[str] = []
    for entry in sorted(path.glob("*.toml")):
        raw = load_toml_file(entry, default={})
        for key, guidance in TARGET_FILE_WARNINGS.items():
            if key in raw:
                warnings.append(
                    f"target file {entry} defines `{key}`; {guidance}"
                )
    return warnings


STALE_EVIDENCE_DAYS = 180


def queue_evidence_warnings(protocols: dict[str, ProtocolRecord]) -> list[str]:
    """Report site policy that claims verification but has aged out.

    A queue saying `evidence = "verified-by-run"` is the strongest claim in the
    config, and `preflight` refuses submissions on the strength of it.  Cluster
    associations change without announcement, so the claim needs a date on it
    and the date needs somebody to look at it -- otherwise "verified" quietly
    decays into "was true once", which is the failure mode the evidence classes
    exist to prevent.  A warning, never an error: a stale fact is usually still
    the right fact, and doctor's job here is to say when it was last checked.
    """
    warnings: list[str] = []
    today = datetime.date.today()
    for name, protocol in sorted(protocols.items()):
        for queue in protocol.queues:
            if queue.evidence not in ("verified-by-run", "verified-live"):
                continue
            if not queue.as_of:
                warnings.append(
                    f"queue {queue.name!r} in protocol {name!r} claims "
                    f"{queue.evidence!r} with no `as_of` date, so nothing can say "
                    "whether it still holds"
                )
                continue
            try:
                seen = datetime.date.fromisoformat(queue.as_of)
            except ValueError:
                warnings.append(
                    f"queue {queue.name!r} in protocol {name!r} has an unreadable "
                    f"`as_of` ({queue.as_of!r}); use YYYY-MM-DD"
                )
                continue
            age = (today - seen).days
            if age > STALE_EVIDENCE_DAYS:
                warnings.append(
                    f"queue {queue.name!r} in protocol {name!r} was last verified "
                    f"{age} days ago ({queue.as_of}); re-check its accounts, QOS "
                    "and limits with a real job before trusting a preflight PASS"
                )
    return warnings


def deprecated_key_warnings(paths: FleetPaths) -> list[str]:
    """Name every config file still carrying a key nothing reads."""
    warnings: list[str] = []
    for directory, dead in (
        (paths.targets_dir, DEPRECATED_TARGET_KEYS),
        (paths.protocols_dir, DEPRECATED_PROTOCOL_KEYS),
        (paths.pools_dir, DEPRECATED_POOL_KEYS),
        (paths.profiles_dir, DEPRECATED_PROFILE_KEYS),
        # Only the key name is ever reported, never a value: a secret file is
        # named and inspected here, not printed.
        (paths.secrets_dir, DEPRECATED_SECRET_KEYS),
    ):
        if not directory.exists():
            continue
        for entry in sorted(directory.glob("*.toml")):
            raw = load_toml_file(entry, default={})
            for key, why in dead.items():
                if key in raw:
                    warnings.append(
                        f"{entry} still defines `{key}`, which fleetctl ignores: "
                        f"{why}. Run `fleetctl migrate-config`."
                    )
    config_defaults = load_toml_file(paths.config_file, default={}).get("defaults")
    if isinstance(config_defaults, dict):
        for key, why in DEPRECATED_CONFIG_DEFAULTS_KEYS.items():
            if key in config_defaults:
                warnings.append(
                    f"{paths.config_file} still defines `[defaults] {key}`, which "
                    f"fleetctl ignores: {why}. Run `fleetctl migrate-config`."
                )
    return warnings


def parse_secret_dict(raw: dict[str, Any], *, source: Path | None = None) -> FleetSecret:
    """Parse one secret record from TOML-style data."""
    # A typo here is quiet and dangerous in a different way to the other
    # loaders: a misspelled `identity_file` falls back to whatever the agent
    # happens to offer, and a misspelled `port` reaches a different service on
    # the same host.
    reject_unknown_keys(
        raw,
        SECRET_KEYS,
        what="secret record",
        source=source,
        deprecated=DEPRECATED_SECRET_KEYS,
    )
    host = optional_str(raw.get("host"))
    user = optional_str(raw.get("user"))
    if not host or not user:
        raise FleetError("secret record must define both `host` and `user`")
    port = int(raw.get("port", 22))
    auth = check_vocabulary(
        str(raw.get("auth", "key")),
        AUTH_MODES,
        what="secret record",
        key="auth",
        source=source,
    )
    identity_file = optional_str(raw.get("identity_file"))
    password = optional_str(raw.get("password"))
    strict_host_key_checking = optional_str(raw.get("strict_host_key_checking"))
    if strict_host_key_checking is not None:
        check_vocabulary(
            strict_host_key_checking,
            STRICT_HOST_KEY_MODES,
            what="secret record",
            key="strict_host_key_checking",
            source=source,
        )
    batch_mode_raw = raw.get("batch_mode")
    extra_options_raw = check_table(
        raw.get("ssh_option", {}), what="`[ssh_option]` in secret record", source=source
    )
    return FleetSecret(
        host=host,
        user=user,
        port=port,
        auth=auth,
        identity_file=identity_file,
        password=password,
        identities_only=bool(raw.get("identities_only", True)),
        forward_agent=bool(raw.get("forward_agent", False)),
        compression=bool(raw.get("compression", False)),
        connect_timeout=int(raw.get("connect_timeout", 30)),
        server_alive_interval=int(raw.get("server_alive_interval", 30)),
        server_alive_count_max=int(raw.get("server_alive_count_max", 3)),
        strict_host_key_checking=strict_host_key_checking,
        batch_mode=None if batch_mode_raw is None else bool(batch_mode_raw),
        extra_options={
            str(key): str(value) for key, value in dict(extra_options_raw).items()
        },
    )


def parse_secret_blob(text: str) -> dict[str, Any]:
    """Parse multi-line secret material from an upcall.

    Shared by the `pass` and `command` backends, so the error names neither.
    """
    stripped = text.lstrip()
    if "=" in stripped:
        try:
            return tomllib.loads(stripped)
        except tomllib.TOMLDecodeError as exc:
            raise FleetError(f"invalid TOML secret material: {exc}") from exc
    raise FleetError(
        "secret material must be TOML with keys like `host`, `user`, and `port`"
    )


def optional_str(value: Any) -> str | None:
    """Normalize optional values to strings."""
    if value is None:
        return None
    text = str(value).strip()
    return text or None


def optional_str_tuple(value: Any) -> tuple[str, ...]:
    """Normalize a config value that may be one string or a list of them.

    TOML makes writing `notes = "one thing"` natural and `notes = ["one
    thing"]` pedantic, so both are accepted everywhere a list is meant.
    """
    if value is None:
        return ()
    if isinstance(value, str):
        text = value.strip()
        return (text,) if text else ()
    return tuple(str(item).strip() for item in value if str(item).strip())


def optional_int(value: Any) -> int | None:
    """Normalize optional values to integers."""
    if value is None:
        return None
    if isinstance(value, str) and not value.strip():
        return None
    return int(value)


def optional_float(value: Any) -> float | None:
    """Normalize optional values to floats."""
    if value is None:
        return None
    if isinstance(value, str) and not value.strip():
        return None
    return float(value)


def parse_target_root_arg(value: str) -> tuple[str, str]:
    """Parse TARGET=PATH for per-target project landing strips."""
    target_name, separator, remote_root = value.partition("=")
    target_name = target_name.strip()
    remote_root = remote_root.strip()
    if not separator or not target_name or not remote_root:
        raise FleetError(
            f"invalid --target-root value {value!r}; expected TARGET=/remote/path"
        )
    return target_name, remote_root


def resolve_remote_root(
    target: TargetRecord,
    binding: ProjectBinding | None,
    override: str | None = None,
) -> str | None:
    """Resolve the effective cwd for TARGET."""
    if override:
        return override
    if binding is not None:
        project_root = binding.remote_root_for(target.name)
        if project_root:
            return project_root
        if target.workdir:
            return remote_posix_join(target.workdir, binding.path.name)
        return None
    return target.workdir


# ssh reserves this exit status for its own failures, so a command exiting 255
# means the connection died rather than the remote command failing.
SSH_TRANSPORT_FAILURE = 255

CONTROL_COMMAND_TIMEOUT = 60.0

# How long one route gets to bring up a control master before the next is tried.
# Direct gets the shorter deadline because this is the entire cost of preferring
# it: one timeout per ControlPersist window, paid only when direct is down.
DIRECT_CONNECT_TIMEOUT = 5
BRIDGE_CONNECT_TIMEOUT = 10

# `ssh -O check` speaks only to a local unix socket, so anything slower than this
# is a hung socket rather than a slow network.
CONTROL_CHECK_TIMEOUT = 10.0

# A unix domain socket path cannot exceed 104 bytes on macOS or 108 on Linux, and
# ssh reports the overflow as a bare "ControlPath too long" from wherever in a
# ProxyCommand chain it happened -- which is not where anyone looks, so the
# length is worth refusing before anything connects.
#
# `%C` is the only token whose expansion has a fixed width, and budgeting it
# alone was the bug: `%h`, `%r`, `%p`, `%l`, `%n` and `%u` were each charged the
# two literal bytes they occupy, so a control_path of `mux/%h-%r` measured 9 and
# expanded to whatever the hostname and account happened to be.  Every token is
# now budgeted at the widest it can plausibly get.  The asymmetry is deliberate:
# an over-estimate costs one config edit that the message names, while an
# under-estimate costs exactly the failure this guard exists to prevent.
CONTROL_PATH_LIMIT = 100
CONTROL_PATH_HASH_WIDTH = 40
CONTROL_PATH_TOKEN_WIDTHS = {
    "%C": CONTROL_PATH_HASH_WIDTH,
    "%h": 64,  # remote host, as connected to
    "%n": 64,  # remote host, as it was written on the command line
    "%l": 64,  # local host, fully qualified
    "%d": 64,  # local home directory
    "%L": 32,  # local host, first label only
    "%r": 32,  # remote user
    "%u": 32,  # local user
    "%i": 10,  # local uid
    "%p": 5,  # port
}
SUBMIT_COMMAND_TIMEOUT = 120.0
PASS_COMMAND_TIMEOUT = 120.0

SUBMIT_RESOURCE_FLAGS = (
    ("queue", "--queue"),
    ("gpus", "--gpus"),
    ("time", "--time"),
    ("mem", "--mem"),
    ("cpus_per_task", "--cpus-per-task"),
    # `--account`/`--qos` decide #SBATCH lines the same way the rest of this
    # tuple does, so `--native-batch` (whose own #SBATCH directives are the
    # only ones that count) refuses them here for free -- see
    # ensure_no_resource_flags's one caller for `--native-batch`.
    ("account", "--account"),
    ("qos", "--qos"),
)


def ensure_no_resource_flags(args: argparse.Namespace, *, because: str) -> None:
    """Refuse resource flags on a submit path that cannot honour them."""
    supplied = [
        flag
        for attr, flag in SUBMIT_RESOURCE_FLAGS
        if getattr(args, attr, None) not in (None, "")
    ]
    if supplied:
        raise FleetError(
            f"{', '.join(supplied)} cannot be applied here: {because}"
        )


def ensure_job_id_pattern(profile: ProfileRecord) -> None:
    """Catch a profile that could never report a job id, before anything is submitted."""
    if not profile.job_id_pattern:
        raise FleetError(
            f"profile {profile.name!r} defines `submit_command` but no "
            "`job_id_pattern`, so a submitted job's id could never be reported back. "
            f"Add `job_id_pattern` to profiles.d/{profile.name}.toml"
        )


def submit_staged_script(
    secret: "FleetSecret",
    profile: "ProfileRecord",
    *,
    remote_script: str,
    cwd: str | None,
    ssh_runtime: dict[str, Any],
    output_path: str | None = None,
    error_path: str | None = None,
    ledger: tuple[FleetPaths, dict[str, Any]] | None = None,
) -> int:
    """Hand one already-staged script to the profile's scheduler."""
    submit_argv = render_template_values(
        profile.submit_command,
        script_path=remote_script,
        workdir=cwd,
    )
    if not submit_argv:  # unreachable: check_protocol_profile ran at resolve time
        raise FleetError(f"profile {profile.name!r} does not define `submit_command`")
    completed = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=remote_shell_command(submit_argv, cwd=cwd),
        capture_output=True,
        timeout=SUBMIT_COMMAND_TIMEOUT,
        **ssh_runtime,
    )
    return report_submitted_job(
        completed,
        profile,
        output_path=output_path,
        error_path=error_path,
        ledger=ledger,
    )


def report_submitted_job(
    completed: subprocess.CompletedProcess[str],
    profile: ProfileRecord,
    *,
    output_path: str | None = None,
    error_path: str | None = None,
    ledger: tuple[FleetPaths, dict[str, Any]] | None = None,
) -> int:
    """Echo scheduler output and report the job id without ever losing a queued job.

    Once the scheduler accepts the script the job exists, so nothing here may raise:
    a traceback at this point would orphan a real allocation whose only identifier
    was in output we had not printed yet.

    The ledger is stamped here rather than by the caller because this is the only
    place holding both the parsed id and the log paths with `%j` already resolved,
    and it is stamped last, after everything the operator sees -- so recording a
    job can never be what comes between a queued job and its id reaching the
    terminal.  A submission whose id could not be parsed is not recorded at all:
    the ledger answers questions keyed on an id, and the warning below already
    says what to do instead.
    """
    if completed.stdout:
        print(completed.stdout, end="")
    if completed.stderr:
        print(completed.stderr, end="", file=sys.stderr)
    if completed.returncode != 0:
        return completed.returncode

    match = (
        re.search(profile.job_id_pattern, completed.stdout)
        if profile.job_id_pattern
        else None
    )
    if match is None:
        print(
            "warning: the scheduler accepted the script but its job id could not be "
            f"parsed (job_id_pattern={profile.job_id_pattern!r}). The job IS most "
            "likely queued: read the scheduler output above and confirm with "
            "`squeue --me` before submitting again.",
            file=sys.stderr,
        )
        return completed.returncode

    job_id = match.groupdict().get("job_id")
    if not job_id:
        job_id = match.group(1) if match.groups() else match.group(0)
    print(f"job_id={job_id}")
    resolved_out = output_path.replace("%j", job_id) if output_path else ""
    resolved_err = error_path.replace("%j", job_id) if error_path else ""
    if resolved_out:
        print(f"log_out={resolved_out}")
    if resolved_err:
        print(f"log_err={resolved_err}")
    if ledger is not None:
        paths, record = ledger
        record_submitted_job(
            paths,
            {
                **record,
                "job_id": job_id,
                "log_out": resolved_out,
                "log_err": resolved_err,
            },
        )
    return completed.returncode


def ensure_target_enabled(target: TargetRecord) -> TargetRecord:
    """Refuse to act on a target the operator has explicitly disabled."""
    if not target.enabled:
        raise FleetError(
            f"target {target.name!r} is disabled (`enabled = false`); re-enable it in "
            f"~/.config/fleet/targets.d/{target.name}.toml if it is back in service"
        )
    return target


UNSAFE_SYNC_DELETE_ROOTS = frozenset({"", ".", "..", "~", "/", "*"})
# Directories whose immediate children are home directories.  `/rhome` is the
# AMD site's; the rest are the usual Linux and macOS layouts.
HOME_DIRECTORY_ROOTS = ("/home", "/Users", "/rhome", "/export/home")
# Trees that contain operating-system state rather than project data.  A typo
# in a destination under one of these roots can damage a host even when it is
# not the root itself (for example, `/etc/ssh`).
PROTECTED_SYNC_DELETE_ROOTS = (
    "/bin", "/boot", "/dev", "/etc", "/lib", "/lib64", "/opt",
    "/proc", "/root", "/run", "/sbin", "/sys", "/usr", "/var",
)
PROTECTED_HOME_SYNC_DELETE_DIRS = (".ssh", ".gnupg", ".config", ".local", ".cache")


def normalize_remote_path(path: str) -> tuple[str, str]:
    """Reduce a remote path to (anchor, normalized path) for comparison.

    The anchor is "~" for a home-relative path, "/" for an absolute one, and
    "." for one still relative to nothing.  Normalizing is the point: `~/.`,
    `/home/u/`, `/home/u/work/..` and `../..` from a project root are all
    spellings, and a guard that compares spellings refuses `~` and allows
    `~/.`, which is the same directory.
    """
    if path == "~" or path.startswith("~/"):
        return "~", posixpath.normpath(path[2:] or ".")
    if path.startswith("/"):
        # normpath keeps a leading `//` (POSIX leaves it implementation-defined);
        # no host this tool reaches gives it a meaning, so collapse it.
        return "/", "/" + posixpath.normpath(path).lstrip("/")
    return ".", posixpath.normpath(path)


def remote_path_is_within(path: tuple[str, str], other: tuple[str, str]) -> bool:
    """True when normalized PATH is OTHER or lies inside it."""
    if path[0] != other[0]:
        return False
    if path[1] == other[1] or other[1] in ("/", "."):
        return True
    return path[1].startswith(other[1].rstrip("/") + "/")


def unsafe_delete_reason(anchor: str, normalized: str) -> str | None:
    """Why `--delete` against this path would be refused outright, if it would."""
    if anchor == "~":
        if normalized == ".":
            return "that is the whole home directory"
        if normalized == ".." or normalized.startswith("../"):
            return "that is above the home directory"
        return None
    if anchor == "/":
        parts = [part for part in normalized.split("/") if part]
        if not parts:
            return "that is the root directory"
        if any(
            normalized == root or normalized.startswith(root + "/")
            for root in PROTECTED_SYNC_DELETE_ROOTS
        ):
            return f"{normalized!r} is inside a protected system directory"
        if len(parts) == 1:
            return f"that is the top-level directory {normalized!r}"
        if normalized == "/root" or (
            len(parts) == 2 and f"/{parts[0]}" in HOME_DIRECTORY_ROOTS
        ):
            return f"{normalized!r} is a home directory"
        return None
    if normalized in UNSAFE_SYNC_DELETE_ROOTS or normalized.startswith("../"):
        return "a relative path with no project root to anchor it names nothing definite"
    return None


def ensure_sync_delete_allowed(
    remote_path: str,
    target: TargetRecord,
    *,
    direction: str,
    force: bool,
) -> None:
    """Refuse `--delete` where a mistake would erase a whole home directory.

    `rsync --delete` removes everything at the destination that the source
    lacks, so the destination is the whole question.  It is decided on what the
    path *names* after normalization, never on how it was typed: the version of
    this that matched literal spellings refused `~` and allowed `~/.`,
    `/home/<user>`, and `../..` from a project root -- each of which is a home
    directory.  --force does not lift these; it exists for the workdir, below.
    """
    if any(marker in remote_path for marker in ("$", "`")):
        raise FleetError(
            f"refusing `--delete` against {remote_path!r} on {target.name!r}: a "
            "shell variable is expanded, or not, by the remote side, so what it "
            "names cannot be checked from here. Spell the path out."
        )


    if remote_path.startswith("~") and not (
        remote_path == "~" or remote_path.startswith("~/")
    ):
        raise FleetError(
            f"refusing `--delete` against {remote_path!r} on {target.name!r}: "
            "named-user home paths are ambiguous; use an explicit project path"
        )
    if remote_path.strip() in UNSAFE_SYNC_DELETE_ROOTS:
        raise FleetError(
            f"refusing `--delete` against remote path {remote_path!r} on "
            f"{target.name!r}: that is a whole home or root directory, not a "
            "project directory"
        )
    anchor, normalized = normalize_remote_path(remote_path)
    reason = unsafe_delete_reason(anchor, normalized)
    if reason:
        raise FleetError(
            f"refusing `--delete` against remote path {remote_path!r} on "
            f"{target.name!r}: {reason}, not a project directory"
        )
    if target.workdir:
        path = (anchor, normalized)
        workdir = normalize_remote_path(target.workdir)
        if path != workdir and remote_path_is_within(workdir, path):
            raise FleetError(
                f"refusing `--delete` against {remote_path!r} on {target.name!r}: "
                f"it contains the host-level workdir {target.workdir!r}, so it is "
                "broader than any one project"
            )
        if path == workdir and not force:
            raise FleetError(
                f"refusing `--delete` against the host-level workdir {target.workdir!r} "
                f"on {target.name!r}; sync a project path instead, or pass --force if you "
                "really mean the entire workdir"
            )
    if direction == "pull" and not force:
        raise FleetError(
            "`sync pull --delete` removes local files that are missing on the remote, "
            "including everything `sync push` refused to upload (.git/, .venv/, .env, "
            "artifacts/); re-run with --force if that is what you want"
        )


def ensure_local_sync_delete_allowed(path: str | Path) -> Path:
    """Refuse local pull destinations that name a root, home, or system tree."""
    resolved = Path(path).expanduser().resolve()
    normalized = "/" + str(resolved).lstrip("/")
    reason = unsafe_delete_reason("/", normalized)
    home = Path.home().resolve()
    if resolved == home or home.is_relative_to(resolved):
        reason = reason or "that is the local home directory or one of its ancestors"
    ensure_home_config_sync_delete_allowed(str(resolved), str(home), "local")
    if reason:
        raise FleetError(
            f"refusing `sync pull --delete` against local path {str(resolved)!r}: "
            f"{reason}, not a project directory"
        )
    return resolved


def resolve_remote_delete_path(
    secret: FleetSecret, remote_path: str, runtime: dict[str, object],
    workdir: str | None = None,
) -> tuple[str, str, str | None]:
    """Resolve a remote destination, home, and workdir before safety checks."""
    script = remote_delete_path_script(remote_path, workdir)
    completed = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=shlex.join(["/bin/sh", "-c", script]),
        capture_output=True,
        timeout=CONTROL_COMMAND_TIMEOUT,
        **runtime,
    )
    return parse_remote_delete_paths(completed, secret.target, remote_path, workdir)


def remote_delete_path_script(remote_path: str, workdir: str | None = None) -> str:
    """Shell script that prints canonical destination, HOME, and optional workdir."""
    script = (
        f"destination=$(realpath -m -- {quote_remote_path(remote_path)}) && "
        "home=$(realpath -m -- \"$HOME\") && "
        "for name in .ssh .gnupg .config .local .cache; do "
        "protected=$(realpath -m -- \"$HOME/$name\") || exit 1; "
        "case \"$destination\" in \"$protected\"|\"$protected\"/*) "
        "printf '%s\\n' 'protected home directory'; exit 73;; esac; "
        "done && printf '%s\\n%s\\n' \"$destination\" \"$home\""
    )
    if workdir:
        script += (
            f" && workdir=$(realpath -m -- {quote_remote_path(workdir)})"
            " && printf '%s\\n' \"$workdir\""
        )

    return script


def parse_remote_delete_paths(
    completed: subprocess.CompletedProcess[str],
    target_name: str,
    remote_path: str,
    workdir: str | None = None,
) -> tuple[str, str, str | None]:
    """Validate canonical paths returned by remote_delete_path_script."""
    lines = (completed.stdout or "").splitlines()
    expected = 3 if workdir else 2
    resolved, home = (lines[0], lines[1]) if len(lines) == expected else ("", "")
    resolved_workdir = lines[2] if workdir and len(lines) == expected else None
    if completed.returncode == 73 and "protected home directory" in lines:
        raise FleetError(
            f"refusing `sync --delete` against remote target {target_name!r}: "
            "destination resolves inside a protected home directory"
        )
    if completed.returncode != 0 or not resolved.startswith("/") or not home.startswith("/"):
        raise FleetError(
            f"could not safely resolve remote delete destination {remote_path!r} "
            f"on {target_name!r}; refusing destructive sync"
        )
    if resolved_workdir is not None and not resolved_workdir.startswith("/"):
        raise FleetError(
            f"could not safely resolve remote workdir on {target_name!r}; "
            "refusing destructive sync"
        )
    return resolved, home, resolved_workdir


def ensure_remote_home_not_target(
    resolved_path: str, resolved_home: str, target: TargetRecord,
) -> None:
    """Refuse the remote account home and every ancestor of that home."""
    if resolved_path == resolved_home or remote_path_is_within(
        ("/", resolved_home), ("/", resolved_path)
    ):
        raise FleetError(
            f"refusing `--delete` against remote path {resolved_path!r} on "
            f"{target.name!r}: it is the remote home directory or an ancestor"
        )
    ensure_home_config_sync_delete_allowed(
        resolved_path, resolved_home, f"remote target {target.name!r}"
    )


def ensure_home_config_sync_delete_allowed(
    resolved_path: str, resolved_home: str, context: str
) -> None:
    """Refuse destructive sync into protected config/cache trees below HOME."""
    for name in PROTECTED_HOME_SYNC_DELETE_DIRS:
        protected = str(Path(resolved_home, name).resolve())
        if resolved_path == protected or resolved_path.startswith(protected + "/"):
            raise FleetError(
                f"refusing `sync --delete` against {context} path "
                f"{resolved_path!r}: it is inside protected home directory "
                f"{protected!r}"
            )


def ensure_private_dir(path: Path, *, mode: int) -> None:
    """Create PATH and enforce private directory permissions."""
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)


def write_text_file(path: Path, content: str, *, mode: int, force: bool = True) -> None:
    """Write CONTENT atomically to PATH with MODE."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and not force:
        raise FleetError(f"refusing to overwrite existing file {path}")
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, delete=False
    ) as handle:
        handle.write(content)
        temp_path = Path(handle.name)
    os.chmod(temp_path, mode)
    temp_path.replace(path)


def write_text_if_missing(path: Path, content: str, *, mode: int) -> None:
    """Create PATH with CONTENT only when absent, race-free between two racing creators.

    Delegating to `write_text_file(force=False)` used to mean: check `exists()`,
    then separately write a temp file and rename over it, and raise if a second
    check inside that write found the file already there.  Two fleetctl
    processes racing to create the same first-run file (this is called from
    `base_ssh_runtime_kwargs`, on every command) could both pass the outer
    check and then have the loser's own `write_text_file` blow up with
    "refusing to overwrite existing file" -- which is exactly backwards for a
    file whose entire job is to exist with this content, created by whichever
    process gets there first.  O_EXCL makes "I created it" a single atomic
    kernel decision instead of two Python-level checks with a window between
    them: the loser's open() simply fails with FileExistsError, which is
    silently fine here, because the winner's content is byte-identical to what
    the loser would have written anyway.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, mode)
    except FileExistsError:
        return
    try:
        os.write(fd, content.encode("utf-8"))
    finally:
        os.close(fd)


def _lock_path_for(path: Path) -> Path:
    """The dedicated lock file guarding PATH's read-modify-write cycle.

    A separate, never-replaced file rather than flocking PATH itself: PATH is
    written by tmp-file-plus-rename (below and in write_text_file), which
    swaps the inode out from under any lock held on the old one, so a second
    process opening the *new* PATH after the rename would get a lock on a
    different inode and never see the first process's lock at all.
    """
    return path.with_name(path.name + ".lock")


@contextlib.contextmanager
def flock_guard(path: Path):
    """Hold an exclusive fcntl lock across one read-modify-write cycle on PATH.

    Every reader/writer of shared, concurrently-touched state (routes.json,
    the control-budget bucket, the audit/ledger trim) wraps its whole
    read-then-decide-then-write in this, so two fleetctl processes racing each
    other never interleave into a lost update.  See `_lock_path_for` for why
    the lock lives on a sibling file rather than on PATH itself.
    """
    lock_path = _lock_path_for(path)
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, PRIVATE_FILE_MODE)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def write_json_atomic(
    path: Path, data: Any, *, mode: int, indent: int | None = None
) -> None:
    """Write DATA as JSON to PATH via tmp file + fsync + atomic rename.

    Callers that need the read-modify-write itself to be race-free (not just
    this one write) wrap the whole cycle in `flock_guard(path)`; this function
    only makes the write half of it atomic and durable, which is what the
    control budget's "tmp + fsync + rename" requirement asks for and a strict
    improvement to reuse for routes.json too.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, delete=False
    ) as handle:
        json.dump(data, handle, sort_keys=True, indent=indent)
        handle.flush()
        os.fsync(handle.fileno())
        temp_path = Path(handle.name)
    os.chmod(temp_path, mode)
    temp_path.replace(path)


def carry_secret_files(source_dir: Path, dest_dir: Path) -> list[str]:
    """Copy existing secret files into a staging tree so a deploy cannot lose them."""
    if not source_dir.is_dir():
        return []
    carried: list[str] = []
    for entry in sorted(source_dir.glob("*.toml")):
        destination = dest_dir / entry.name
        shutil.copy2(entry, destination)
        os.chmod(destination, PRIVATE_FILE_MODE)
        carried.append(entry.name)
    return carried


def swap_config_tree(staging: Path, live: Path) -> Path | None:
    """Replace `live` with `staging` by rename, keeping one previous generation.

    Both paths share a parent, so each rename is atomic: no reader ever sees a
    half-written config tree, and a failure part-way through puts the old tree
    back where it was.
    """
    previous = live.with_name(live.name + ".prev")
    rotated = False
    if live.exists():
        if previous.exists():
            shutil.rmtree(previous)
        os.replace(live, previous)
        rotated = True
    try:
        os.replace(staging, live)
    except OSError:
        if rotated and not live.exists():
            os.replace(previous, live)
        raise
    return previous if rotated else None

SECRET_COMMAND_TIMEOUT = 30.0

# How long one resolved upcall is reused.  ClusterShell caches its external group
# sources too, but for an hour by default; this is far shorter because what is
# cached is the address of a machine that moves, and a stale address is a
# connection to whoever holds that address now.  It only has to cover the window
# where two resolutions of one target must agree -- `sync push` and the `submit`
# after it -- and it is deliberately not long enough to survive a coffee break.
SECRET_COMMAND_TTL = 30.0

# In-process only, and deliberately not a file under the state home.  A disk
# cache of resolved secret material would be a second secret store with none of
# the handling the first one gets, and the window that needs covering is one
# command, not one week.  Locked because a fan-out resolves several targets at
# once and they may share an upcall.
_SECRET_COMMAND_CACHE: dict[str, tuple[float, dict[str, Any]]] = {}
_SECRET_COMMAND_LOCK = threading.Lock()


def run_upcall(
    argv: list[str],
    *,
    timeout: float,
    input: str | None = None,
    env: dict[str, str] | None = None,
) -> "subprocess.CompletedProcess[str]":
    """`subprocess.run` for a secret upcall, except a timeout kills its group.

    Plain `subprocess.run` kills only the direct child on timeout, so anything
    the upcall spawned would outlive it.  This follows run_command's pattern:
    its own session, and the whole group killed when the timeout hits.
    """
    with subprocess.Popen(
        argv,
        text=True,
        env=env,
        start_new_session=True,
        stdin=subprocess.PIPE if input is not None else None,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ) as process:
        try:
            stdout, stderr = process.communicate(input, timeout=timeout)
        except subprocess.TimeoutExpired:
            _kill_process_group(process)
            raise
    return subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)


def run_secret_command(command: str, *, what: str) -> dict[str, Any]:
    """Run one secret upcall and parse its output, cached for the TTL.

    The whole point is to resolve a churning cloud address at connect time
    without teaching fleetctl a cloud API: the command knows, fleetctl asks.

    Its stdout is a secret, which is why the failure path reports stderr and
    never stdout.  `run_pass_show` can fall back to printing stdout because
    `pass` writes diagnostics there when it fails; an upcall that exits non-zero
    has already put the first half of a credential there instead.  A failure is a
    FleetError naming the command that failed -- never a partial secret handed on
    to the connection layer, which would resolve to a target nobody chose.
    """
    argv = shlex.split(command)
    if not argv:
        raise FleetError(
            f"`secret_ref` for {what} is empty, but the `command` backend reads "
            "it as the command to run"
        )
    with _SECRET_COMMAND_LOCK:
        cached = _SECRET_COMMAND_CACHE.get(command)
        if cached is not None and cached[0] > time.monotonic():
            return dict(cached[1])
    try:
        completed = run_upcall(argv, timeout=SECRET_COMMAND_TIMEOUT)
    except FileNotFoundError as exc:
        raise FleetError(
            f"secret command for {what} cannot be run: {argv[0]!r} not found"
        ) from exc
    except subprocess.TimeoutExpired as exc:
        raise FleetError(
            f"secret command for {what} timed out after "
            f"{SECRET_COMMAND_TIMEOUT:g}s: {shlex.join(argv)}"
        ) from exc
    if completed.returncode != 0:
        detail = (completed.stderr or "").strip().splitlines()
        raise FleetError(
            f"secret command for {what} exited {completed.returncode}: "
            + (detail[-1] if detail else "nothing on stderr to explain it")
        )
    values = parse_secret_blob(completed.stdout)
    with _SECRET_COMMAND_LOCK:
        _SECRET_COMMAND_CACHE[command] = (
            time.monotonic() + SECRET_COMMAND_TTL,
            dict(values),
        )
    return values


def run_pass_show(secret_ref: str) -> str:
    """Fetch one pass entry."""
    try:
        completed = run_upcall(["pass", "show", secret_ref], timeout=PASS_COMMAND_TIMEOUT)
    except FileNotFoundError as exc:
        raise FleetError("`pass` is required for pass-backed secrets") from exc
    except subprocess.TimeoutExpired as exc:
        raise FleetError(
            f"`pass show {secret_ref}` timed out after {PASS_COMMAND_TIMEOUT:g}s; "
            "gpg-agent is probably waiting on a passphrase or a smartcard"
        ) from exc
    if completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip()
        raise FleetError(
            f"failed to read pass secret {secret_ref!r}: {message or 'unknown error'}"
        )
    return completed.stdout


def password_store_root() -> Path:
    """Resolve the password-store root directory."""
    return expand_local_path(os.environ.get("PASSWORD_STORE_DIR", "~/.password-store"))


def pass_entry_path(secret_ref: str) -> Path:
    """Map one pass entry name to its on-disk `.gpg` path."""
    relative = Path(secret_ref)
    return password_store_root() / relative.parent / f"{relative.name}.gpg"


def pass_entry_exists(secret_ref: str) -> bool:
    """Return whether one pass entry currently exists."""
    return pass_entry_path(secret_ref).exists()


def list_pass_entries(prefix: str) -> list[str]:
    """List pass entry names relative to PREFIX."""
    root = password_store_root() / Path(prefix)
    if not root.exists():
        return []
    entries: list[str] = []
    for entry in sorted(root.rglob("*.gpg")):
        entries.append(str(entry.relative_to(root)).removesuffix(".gpg"))
    return entries


def run_pass_insert(secret_ref: str, content: str, *, force: bool) -> None:
    """Write one pass entry from multi-line CONTENT."""
    command = ["pass", "insert", "-m"]
    if force:
        command.append("-f")
    command.append(secret_ref)
    env = os.environ.copy()
    existing_gpg_opts = env.get("PASSWORD_STORE_GPG_OPTS", "").strip()
    extra_gpg_opts = "--batch --yes --trust-model always"
    env["PASSWORD_STORE_GPG_OPTS"] = (
        f"{existing_gpg_opts} {extra_gpg_opts}".strip()
    )
    try:
        completed = run_upcall(
            command, input=content, env=env, timeout=PASS_COMMAND_TIMEOUT
        )
    except FileNotFoundError as exc:
        raise FleetError("`pass` is required for pass-backed fleet config") from exc
    except subprocess.TimeoutExpired as exc:
        raise FleetError(
            f"`pass` timed out after {PASS_COMMAND_TIMEOUT:g}s writing {secret_ref}; "
            "gpg-agent is probably waiting on a passphrase or a smartcard"
        ) from exc
    if completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip()
        raise FleetError(
            f"failed to write pass entry {secret_ref!r}: {message or 'unknown error'}"
        )


def ssh_env(secret: FleetSecret) -> dict[str, str]:
    """Prepare subprocess environment for SSH-family commands."""
    env = os.environ.copy()
    if secret.auth == "password" and secret.password is not None:
        env["SSHPASS"] = secret.password
    return env


def base_ssh_runtime_kwargs(context: FleetContext) -> dict[str, Any]:
    """Return the fleet-managed SSH settings that do not depend on the route."""
    ensure_private_dir(context.paths.state_home, mode=STATE_DIR_MODE)
    ensure_private_dir(context.paths.cache_home, mode=PRIVATE_DIR_MODE)
    ensure_private_dir(context.paths.control_dir, mode=PRIVATE_DIR_MODE)
    write_text_if_missing(context.paths.known_hosts_file, "", mode=PRIVATE_FILE_MODE)
    ssh_config = dict(context.config.get("ssh", {}))
    return {
        "known_hosts_file": expand_path_text(
            str(ssh_config.get("user_known_hosts_file", context.paths.known_hosts_file))
        ),
        "control_path": expand_path_text(
            str(ssh_config.get("control_path", context.paths.control_dir / "%C"))
        ),
        "strict_host_key_checking": optional_str(
            ssh_config.get("strict_host_key_checking")
        )
        or "accept-new",
        "update_host_keys": bool(ssh_config.get("update_host_keys", True)),
    }


def escape_ssh_percent(text: str) -> str:
    """Double every `%` so the ssh running a ProxyCommand leaves it alone.

    A ProxyCommand is percent-expanded by the ssh that spawns it, and OpenSSH
    only knows %%, %h, %n, %p and %r there -- an unescaped `%C` in the bridge's
    ControlPath would abort the connection with "unknown key".  Escaping the
    inner options exactly once per level of nesting means each ssh in the chain
    consumes one layer and the innermost one still sees its own `%C`, which is
    what gives every hop its own multiplexed socket.
    """
    return text.replace("%", "%%")


def route_connect_timeout(route: str) -> int:
    """Return how long ROUTE gets to bring up a control master."""
    if route_bridge(route) is None:
        return DIRECT_CONNECT_TIMEOUT
    return BRIDGE_CONNECT_TIMEOUT


def control_path_width(path: str) -> int:
    """Return the widest PATH can get once ssh expands its percent tokens.

    Scanned rather than counted, because `%%` is a literal percent: counting
    occurrences of `%h` would read the `h` in `%%h` as a hostname and inflate a
    path that is already safe.  An unknown token is charged its two literal
    bytes, since ssh rejects it by name long before its length matters.
    """
    width = 0
    index = 0
    while index < len(path):
        if path[index] != "%" or index + 1 >= len(path):
            width += 1
            index += 1
            continue
        token = path[index : index + 2]
        width += 1 if token == "%%" else CONTROL_PATH_TOKEN_WIDTHS.get(token, 2)
        index += 2
    return width


def route_control_path(control_path: str, route: str) -> str:
    """Return the control socket that belongs to ROUTE.

    OpenSSH's `%C` hashes the local host, remote host, port and user -- not the
    ProxyCommand -- so without this suffix both routes to one host share a
    socket, and a warm direct master goes on serving a `--route via:` command
    until ControlPersist expires.  The suffix is what makes the route part of a
    connection's identity, and therefore what lets a fallback mean anything.
    """
    bridge = route_bridge(route)
    token = ROUTE_DIRECT if bridge is None else f"via-{bridge}"
    path = f"{control_path}-{token}"
    expanded = control_path_width(path)
    if expanded > CONTROL_PATH_LIMIT:
        raise FleetError(
            f"the control socket for route {route!r} can expand to {expanded} bytes, "
            f"over the {CONTROL_PATH_LIMIT} a unix socket allows: shorten "
            '`control_path` under [ssh] in config.toml, e.g. "~/.cache/fleet/m/%C"'
        )
    return path


def route_runtime(base: dict[str, Any], route: str) -> dict[str, Any]:
    """Return BASE carrying the control socket that belongs to ROUTE.

    An empty `control_path` turns multiplexing off, and then there is no socket to
    suffix and no master to establish: the first route becomes the only route.
    """
    control_path = base.get("control_path")
    if not control_path:
        return dict(base)
    return {**base, "control_path": route_control_path(str(control_path), route)}


def build_proxy_command(
    context: FleetContext,
    route: str,
    base: dict[str, Any],
    *,
    chain: tuple[str, ...] = (),
) -> str | None:
    """Render the ProxyCommand that carries a connection along ROUTE.

    The hop is a full fleetctl connection to the bridge -- its own secret, and
    the same private known_hosts, IdentitiesOnly, timeouts and control socket the
    destination gets -- and it chains, because a bridge may itself be reached
    through one.  `-W` forwards a stream and runs nothing, which is why using a
    bridge is transport rather than execution and needs no admission check:
    `fleetctl exec` against that same bridge is still refused.
    """
    bridge_name = route_bridge(route)
    if bridge_name is None:
        return None
    if bridge_name in chain:
        raise FleetError("reach cycle: " + " -> ".join((*chain, bridge_name)))
    bridge = context.targets.get(bridge_name)
    if bridge is None:
        raise FleetError(
            f"route {route!r} names unknown target {bridge_name!r}; run `fleetctl list`"
        )
    ensure_target_enabled(bridge)
    secret = context.resolve_secret(bridge)
    if secret.auth == "password":
        raise FleetError(
            f"bridge {bridge_name!r} authenticates with a password, which cannot "
            "carry another connection: sshpass hands one password to the whole "
            "process tree, so the hop and the destination would both read it. "
            "Give the bridge a key -- it is the host every other host is reached "
            "through."
        )
    # Which route the bridge is reached over is not decided here.  This function
    # renders a command and has to stay printable offline -- `explain` and every
    # `--dry-run` call it -- so it reads the choice establish_route made and
    # recorded, and falls back to the bridge's first declared route while no
    # master exists yet.  A bridge behind a bridge is the same problem one level
    # down, and gets the same answer.
    bridge_route = context.route_established.get(bridge_name) or (
        bridge.reach[0] if bridge.reach else ROUTE_DIRECT
    )
    parts = ["ssh", "-W", "%h:%p", "-p", str(secret.port)]
    parts += [
        escape_ssh_percent(part)
        for part in ssh_option_parts(
            secret,
            proxy_command=build_proxy_command(
                context,
                bridge_route,
                base,
                chain=(*chain, bridge_name),
            ),
            **route_runtime(base, bridge_route),
        )
    ]
    parts.append(secret.target)
    return shlex.join(parts)


def ssh_runtime_kwargs(
    context: FleetContext,
    *,
    target: TargetRecord | None = None,
    route: str | None = None,
) -> dict[str, Any]:
    """Return fleet-managed SSH runtime settings, TARGET's hop included.

    Without a target these are the host-independent settings.  With one, the
    route's ProxyCommand is part of the runtime, so every builder that already
    forwarded these kwargs carries the bridge without knowing it exists.
    """
    base = base_ssh_runtime_kwargs(context)
    if target is None:
        return base
    chosen = route or (target.reach[0] if target.reach else ROUTE_DIRECT)
    return {
        **route_runtime(base, chosen),
        "proxy_command": build_proxy_command(context, chosen, base),
    }


def ssh_option_parts(
    secret: FleetSecret,
    *,
    known_hosts_file: str | None = None,
    control_path: str | None = None,
    strict_host_key_checking: str | None = None,
    update_host_keys: bool = True,
    proxy_command: str | None = None,
) -> list[str]:
    """Build stable OpenSSH options for one target."""
    options = [
        "-o",
        f"ConnectTimeout={secret.connect_timeout}",
        "-o",
        f"ServerAliveInterval={secret.server_alive_interval}",
        "-o",
        f"ServerAliveCountMax={secret.server_alive_count_max}",
    ]
    if known_hosts_file:
        options += ["-o", f"UserKnownHostsFile={known_hosts_file}"]
    if control_path:
        options += [
            "-o",
            "ControlMaster=auto",
            "-o",
            "ControlPersist=600",
            "-o",
            f"ControlPath={control_path}",
        ]
    if proxy_command:
        options += ["-o", f"ProxyCommand={proxy_command}"]
    if secret.identities_only:
        options += ["-o", "IdentitiesOnly=yes"]
    if secret.forward_agent:
        options += ["-A"]
    if secret.compression:
        options += ["-C"]
    chosen_strict_host_key_checking = (
        secret.strict_host_key_checking or strict_host_key_checking
    )
    if chosen_strict_host_key_checking:
        options += [
            "-o",
            f"StrictHostKeyChecking={chosen_strict_host_key_checking}",
        ]
    if update_host_keys:
        options += ["-o", "UpdateHostKeys=yes"]
    if secret.identity_file:
        options += ["-i", os.path.expanduser(secret.identity_file)]
    if secret.auth == "password":
        options += [
            "-o",
            "PreferredAuthentications=password",
            "-o",
            "PubkeyAuthentication=no",
        ]
    elif use_batch_mode(secret):
        options += ["-o", "BatchMode=yes"]
    for key, value in secret.extra_options.items():
        options += ["-o", f"{key}={value}"]
    return options


def interactive_terminal_available() -> bool:
    """True when a human could answer an ssh passphrase or 2FA prompt."""
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        try:
            if stream is not None and stream.isatty():
                return True
        except (AttributeError, ValueError):
            continue
    return False


def use_batch_mode(secret: FleetSecret) -> bool:
    """Decide whether ssh should be forbidden from prompting.

    `BatchMode=yes` used to be forced on every key-auth target, which makes a
    passphrase-protected key with no agent loaded, or a site using
    keyboard-interactive 2FA, impossible to reach at all.  Prompting is allowed
    whenever there is a terminal to answer on; with no terminal -- cron, CI, a
    pipeline -- batch mode still turns a silent hang into a fast clean failure.
    `batch_mode` in the secret record overrides the heuristic either way.
    """
    if secret.batch_mode is not None:
        return secret.batch_mode
    return not interactive_terminal_available()


def ssh_transport_prefix(secret: FleetSecret) -> list[str]:
    """Return local wrapper commands such as sshpass."""
    if secret.auth != "password" or secret.password is None:
        return []
    return ["sshpass", "-e"]


def build_ssh_command(
    secret: FleetSecret,
    *,
    allocate_tty: bool,
    remote_command: str | None,
    known_hosts_file: str | None = None,
    control_path: str | None = None,
    strict_host_key_checking: str | None = None,
    update_host_keys: bool = True,
    proxy_command: str | None = None,
) -> list[str]:
    """Build one ssh command."""
    command = ssh_transport_prefix(secret) + ["ssh"]
    if allocate_tty:
        command.append("-t")
    command += ["-p", str(secret.port)]
    command += ssh_option_parts(
        secret,
        known_hosts_file=known_hosts_file,
        control_path=control_path,
        strict_host_key_checking=strict_host_key_checking,
        update_host_keys=update_host_keys,
        proxy_command=proxy_command,
    )
    command.append(secret.target)
    if remote_command is not None:
        command.append(remote_command)
    return command


def build_scp_command(
    secret: FleetSecret,
    *,
    source: str,
    dest: str,
    known_hosts_file: str | None = None,
    control_path: str | None = None,
    strict_host_key_checking: str | None = None,
    update_host_keys: bool = True,
    proxy_command: str | None = None,
) -> list[str]:
    """Build one scp command."""
    command = ssh_transport_prefix(secret) + ["scp", "-P", str(secret.port)]
    command += ssh_option_parts(
        secret,
        known_hosts_file=known_hosts_file,
        control_path=control_path,
        strict_host_key_checking=strict_host_key_checking,
        update_host_keys=update_host_keys,
        proxy_command=proxy_command,
    )
    command += [source, dest]
    return command


def build_rsync_transport(
    secret: FleetSecret,
    *,
    known_hosts_file: str | None = None,
    control_path: str | None = None,
    strict_host_key_checking: str | None = None,
    update_host_keys: bool = True,
    proxy_command: str | None = None,
) -> str:
    """Build the SSH transport string for rsync."""
    parts = ssh_transport_prefix(secret) + ["ssh", "-p", str(secret.port)]
    parts += ssh_option_parts(
        secret,
        known_hosts_file=known_hosts_file,
        control_path=control_path,
        strict_host_key_checking=strict_host_key_checking,
        update_host_keys=update_host_keys,
        proxy_command=proxy_command,
    )
    return shlex.join(parts)


# An end-to-end `--timeout` is one deadline shared by every nested local command
# a verb runs -- staging's mkdir/scp/chmod, the control-master probe and
# bring-up, and the verb's own final ssh/scp/rsync -- rather than a per-step
# budget that a slow bridge could exhaust one hop at a time.  A contextvar
# rather than a parameter threaded through every function down to run_command()
# is what makes that true for free: every one of those steps already funnels
# through run_command() below, so setting the deadline once in main() (see
# deadline_scope's call site) reaches all of them without their signatures
# changing.  It is a contextvar and not a plain module global so a fan-out's
# worker threads (ThreadPoolExecutor) each see the deadline for the *call that
# spawned them* rather than racing to overwrite one shared value.
_ACTIVE_DEADLINE: contextvars.ContextVar[float | None] = contextvars.ContextVar(
    "fleetctl_active_deadline", default=None
)


@contextlib.contextmanager
def deadline_scope(timeout: float | None):
    """Make TIMEOUT seconds from now the shared deadline for this block.

    A no-op when TIMEOUT is None -- which is every verb that does not carry
    `--timeout` today, and every verb that carries it but was not given it --
    so nothing about existing behaviour changes until an operator opts in.
    """
    if timeout is None:
        yield
        return
    token = _ACTIVE_DEADLINE.set(time.monotonic() + timeout)
    try:
        yield
    finally:
        _ACTIVE_DEADLINE.reset(token)


def _deadline_remaining() -> float | None:
    """Seconds left on the active --timeout deadline, or None when there is none."""
    ends_at = _ACTIVE_DEADLINE.get()
    if ends_at is None:
        return None
    return ends_at - time.monotonic()


def _clamp_to_deadline(timeout: float | None) -> tuple[float | None, bool]:
    """Return (effective_timeout, clamped_by_deadline).

    CLAMPED_BY_DEADLINE tells run_command() whether an expiry belongs to
    --timeout (raise FleetTimeout, so --json can tell it apart and a bare
    `--timeout` exits 124) or to the call's own fixed timeout (raise the
    ordinary FleetError this file has always raised for that -- unrelated to
    --timeout and unchanged by its existence).
    """
    remaining = _deadline_remaining()
    if remaining is None:
        return timeout, False
    if timeout is None or remaining <= timeout:
        return remaining, True
    return timeout, False


# After a kill, how long to keep draining pipes a descendant outside the killed
# process group may still hold open.
POST_KILL_DRAIN_TIMEOUT = 5.0


def _kill_process_group(process: "subprocess.Popen[str]") -> None:
    """Kill PROCESS's whole process group, not just the direct child.

    Only meaningful when the process was started with start_new_session=True
    (its own group leader); killing the group rather than one pid also catches
    anything it spawned before the timeout hit it -- an askpass helper, a
    ProxyCommand's own child ssh.  Killing it proves only that: it does not
    prove the remote side stopped, which is what --json's `may_have_executed`
    exists to carry forward instead of a false all-clear.
    """
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


def _drain_captured(
    process: "subprocess.Popen[str]",
    *,
    timeout: float | None,
    stdout_limit: int | None,
    stderr_limit: int | None,
) -> tuple[str, str, bool, bool]:
    """Read PROCESS's captured stdout/stderr to completion, bounded by the limits.

    Reading never stops at a limit -- it keeps draining and discarding past it
    -- so a capped read is never the reason the child blocks on a full pipe.
    Plain Popen.communicate() already gives that guarantee unbounded (it exists
    to avoid exactly that deadlock); this adds the same guarantee with a byte
    cap, for --json's stdout/stderr fields.  On a timeout the process group is
    killed and fully reaped here before the TimeoutExpired is re-raised, so the
    caller never has to reach back into these internals to clean up.
    """
    if stdout_limit is None and stderr_limit is None:
        try:
            stdout_text, stderr_text = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            _kill_process_group(process)
            try:
                process.communicate(timeout=POST_KILL_DRAIN_TIMEOUT)
            except subprocess.TimeoutExpired:
                # A descendant in another session (ssh under sshpass) still
                # holds the pipe; the direct child is dead, so stop waiting.
                process.wait()
            raise
        return stdout_text or "", stderr_text or "", False, False

    chunks: dict[str, list[str]] = {"stdout": [], "stderr": []}
    seen: dict[str, int] = {"stdout": 0, "stderr": 0}
    truncated: dict[str, bool] = {"stdout": False, "stderr": False}
    limits: dict[str, int | None] = {"stdout": stdout_limit, "stderr": stderr_limit}

    def pump(stream: Any, key: str) -> None:
        if stream is None:
            return
        limit = limits[key]
        try:
            while True:
                chunk = stream.read(65536)
                if not chunk:
                    return
                if limit is None:
                    chunks[key].append(chunk)
                else:
                    room = limit - seen[key]
                    if room > 0:
                        chunks[key].append(chunk[:room])
                    if len(chunk) > max(room, 0):
                        truncated[key] = True
                seen[key] += len(chunk)
        finally:
            stream.close()

    readers = [
        threading.Thread(target=pump, args=(process.stdout, "stdout"), daemon=True),
        threading.Thread(target=pump, args=(process.stderr, "stderr"), daemon=True),
    ]
    for reader in readers:
        reader.start()
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        _kill_process_group(process)
        for reader in readers:
            reader.join(timeout=POST_KILL_DRAIN_TIMEOUT)
        process.wait()
        raise
    for reader in readers:
        reader.join()
    return (
        "".join(chunks["stdout"]),
        "".join(chunks["stderr"]),
        truncated["stdout"],
        truncated["stderr"],
    )


def run_command(
    command: list[str],
    *,
    env: dict[str, str] | None = None,
    capture_output: bool = False,
    timeout: float | None = None,
    stdout_limit: int | None = None,
    stderr_limit: int | None = None,
) -> subprocess.CompletedProcess[str]:
    """Run one local command with optional capture, an optional deadline, and
    an optional byte cap on each captured stream.

    Every local subprocess in this file -- ssh, scp, rsync, the control-master
    probe/bring-up -- comes through here, which is what lets a single change in
    one place give every one of them an end-to-end `--timeout` (see
    deadline_scope above) and a killable process group, without any call site
    needing to know either exists.  STDOUT_LIMIT/STDERR_LIMIT are unset by
    every call site outside the `--json` result envelope, so this is
    byte-identical to the previous subprocess.run()-based implementation for
    all of them.
    """
    effective_timeout, clamped = _clamp_to_deadline(timeout)
    if effective_timeout is not None and effective_timeout <= 0:
        raise FleetTimeout(
            f"--timeout budget exhausted before running {command[0]}", sent=False
        )
    # A new session (and so a new, killable process group) only when a timeout
    # of some kind is actually in play. Every interactive/TTY invocation in this
    # file runs with no timeout at all, so this leaves job control and signal
    # delivery for `ssh -t` sessions untouched unless the operator combined
    # `--tty` with `--timeout` themselves.
    needs_group = effective_timeout is not None
    try:
        process = subprocess.Popen(
            command,
            env=env,
            text=True,
            start_new_session=needs_group,
            stdout=subprocess.PIPE if capture_output else None,
            stderr=subprocess.PIPE if capture_output else None,
        )
    except FileNotFoundError as exc:
        raise FleetError(f"missing required command: {command[0]}") from exc

    try:
        stdout_text, stderr_text, stdout_truncated, stderr_truncated = _drain_captured(
            process,
            timeout=effective_timeout,
            stdout_limit=stdout_limit if capture_output else None,
            stderr_limit=stderr_limit if capture_output else None,
        )
    except subprocess.TimeoutExpired:
        if clamped:
            raise FleetTimeout(
                f"--timeout budget exhausted running {command[0]}", sent=False
            )
        raise FleetError(
            f"{command[0]} timed out after {timeout:g}s; the remote host may be "
            "unreachable or hung"
        )
    completed = subprocess.CompletedProcess(
        command,
        process.returncode,
        stdout_text if capture_output else None,
        stderr_text if capture_output else None,
    )
    # Bolted-on attributes, not a new return shape: CompletedProcess is a plain
    # class, and every existing caller that never reads these two ignores them
    # exactly as if they were never set.
    completed.stdout_truncated = stdout_truncated
    completed.stderr_truncated = stderr_truncated
    return completed


def run_ssh_command(
    secret: FleetSecret,
    *,
    allocate_tty: bool,
    remote_command: str | None,
    capture_output: bool = False,
    known_hosts_file: str | None = None,
    control_path: str | None = None,
    strict_host_key_checking: str | None = None,
    update_host_keys: bool = True,
    proxy_command: str | None = None,
    timeout: float | None = None,
    stdout_limit: int | None = None,
    stderr_limit: int | None = None,
) -> subprocess.CompletedProcess[str]:
    """Run one ssh command with fleet defaults."""
    command = build_ssh_command(
        secret,
        allocate_tty=allocate_tty,
        remote_command=remote_command,
        known_hosts_file=known_hosts_file,
        control_path=control_path,
        strict_host_key_checking=strict_host_key_checking,
        update_host_keys=update_host_keys,
        proxy_command=proxy_command,
    )
    return run_command(
        command,
        env=ssh_env(secret),
        capture_output=capture_output,
        timeout=timeout,
        stdout_limit=stdout_limit,
        stderr_limit=stderr_limit,
    )


def build_control_request(
    secret: FleetSecret, control_path: str, request: str
) -> list[str]:
    """Build `ssh -O REQUEST` against CONTROL_PATH.

    No transport prefix and no ProxyCommand: `-O` speaks to the local socket only,
    so a password helper would have nothing to answer and the bridge has no part
    in the question of whether the master is up.  The port and `user@host` are
    still passed, because `%C` hashes them.
    """
    return [
        "ssh",
        "-O",
        request,
        "-p",
        str(secret.port),
        "-o",
        f"ControlPath={control_path}",
        secret.target,
    ]


def control_master_alive(secret: FleetSecret, runtime: dict[str, Any]) -> bool:
    """Report whether RUNTIME's control socket has a live master behind it.

    A socket file left behind by a killed master answers this honestly: `-O
    check` connects to the socket instead of trusting that it exists.
    """
    control_path = runtime.get("control_path")
    if not control_path:
        return False
    completed = run_command(
        build_control_request(secret, str(control_path), "check"),
        env=ssh_env(secret),
        capture_output=True,
        timeout=CONTROL_CHECK_TIMEOUT,
    )
    return completed.returncode == 0


def open_control_master(
    secret: FleetSecret, runtime: dict[str, Any], route: str
) -> str | None:
    """Bring up a background control master over ROUTE; return None on success.

    `-N -f` backgrounds after authentication rather than before, so a key
    passphrase or a 2FA prompt is still answerable when there is a terminal to
    answer on -- and when there is not, ssh_option_parts has already set
    `BatchMode=yes`, which turns a silent hang into a fast failure.  Either way
    the subprocess deadline is generous while ConnectTimeout is not.

    ControlMaster is forced to `yes` here, against the `auto` every other
    invocation in this file shares, and that is the whole point of the option.
    Under `auto` the loser of a race between two fleetctl processes is told the
    socket already exists, drops multiplexing and carries on as a plain
    connection -- which, with `-N -f` and no socket to persist into, is a
    background ssh that nothing will ever reap and that exits 0.  So the loser
    leaked a connection per race and reported success.  `yes` fails it instead,
    and the caller re-checks the socket: what it lost to is a live master over
    this same route, so losing the race is not failing.
    """
    command = build_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=None,
        **runtime,
    )
    # Inserted ahead of the secret's own ConnectTimeout, because OpenSSH keeps the
    # first value it is given for an option.  ControlMaster rides the same rule to
    # get ahead of the shared `auto`, and only when there is a socket to own: with
    # multiplexing off, `yes` would be a claim about a socket that never exists.
    insert_at = len(ssh_transport_prefix(secret)) + 1
    command[insert_at:insert_at] = [
        "-N",
        "-f",
        "-o",
        f"ConnectTimeout={route_connect_timeout(route)}",
    ]
    if runtime.get("control_path"):
        command[insert_at:insert_at] = ["-o", "ControlMaster=yes"]
    completed = run_command(
        command,
        env=ssh_env(secret),
        capture_output=True,
        timeout=route_connect_timeout(route) + CONTROL_COMMAND_TIMEOUT,
    )
    if completed.returncode == 0:
        return None
    detail = (completed.stderr or "").strip().splitlines()
    reason = detail[-1] if detail else f"ssh exited {completed.returncode}"
    bridge = route_bridge(route)
    if bridge is not None:
        # A hop fails from the outer ssh's point of view, and that point of view
        # has no names in it: the ProxyCommand is a pipe, so a dead bridge and a
        # destination that the bridge cannot see both read "Connection to UNKNOWN
        # port 65535 timed out".  Name the two ends of the link that did not come
        # up, which is the least a reader needs to know where to look.
        reason = f"{reason} [{secret.host} through bridge {bridge!r}]"
    return reason


def utc_timestamp() -> str:
    """Return the current time as ISO-8601 UTC.

    One spelling for every timestamp fleetctl records, so a state file written on
    a laptop in one timezone still sorts against one written on a login node in
    another.
    """
    return (
        datetime.datetime.now(datetime.timezone.utc)
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z")
    )


def route_state_file(paths: FleetPaths) -> Path:
    """Where the route each target was last reached over is recorded."""
    return paths.state_home / "routes.json"


def read_route_state(paths: FleetPaths) -> dict[str, Any]:
    """Read the route each target was last reached over, for reporting only.

    Never consulted when choosing a route.  A cache that remembered the bridge
    had worked would quietly pin every later command to it, which is the exact
    opposite of preferring the direct path.
    """
    try:
        loaded = json.loads(route_state_file(paths).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return loaded if isinstance(loaded, dict) else {}


def record_route_state(
    paths: FleetPaths, target: str, route: str, control_path: str
) -> None:
    """Record the route TARGET was just reached over.

    Bookkeeping never breaks a connection: a state directory that cannot be
    written costs a line of reporting, not the command that was about to run.
    The read, the merge and the write all happen inside one `flock_guard`, so
    two fleetctl processes recording two different targets' routes at the same
    moment cannot race each other into one process's update clobbering the
    other's -- a plain read-then-write here (the old implementation) is
    exactly that lost-update race, just rare enough to have never been
    noticed.
    """
    try:
        ensure_private_dir(paths.state_home, mode=STATE_DIR_MODE)
        with flock_guard(route_state_file(paths)):
            state = read_route_state(paths)
            state[target] = {
                "route": route,
                "socket": control_path,
                "at": utc_timestamp(),
            }
            write_json_atomic(
                route_state_file(paths), state, mode=PRIVATE_FILE_MODE, indent=2
            )
    except OSError:
        pass


def jobs_ledger_file(paths: FleetPaths) -> Path:
    """Where every submission the scheduler accepted is recorded, one line each."""
    return paths.state_home / "jobs.jsonl"


def audit_log_file(paths: FleetPaths) -> Path:
    """Where every invocation that reached for a host is recorded, one line each."""
    return paths.state_home / "audit.jsonl"


# How many lines each of these files keeps.  A count and not an age: a thirty-day
# array job is still the job you want `job status` to resolve, so forgetting by
# date would drop exactly the record still in use, while forgetting by count only
# drops a job once you have submitted two thousand newer ones.
JSONL_KEEP_LINES = 2000


def _trim_slack(keep: int) -> int:
    """How far over KEEP a JSONL file may drift before a trim is worth its cost.

    "Only when it exceeds the cap by at least 10% or 200 lines" -- rewriting
    the whole file on literally every append (the old rule: trim as soon as
    `len(records) > keep`) meant every single append after the file first
    reached its cap paid a full read-and-rewrite, for a bound that nothing
    needs enforced to the exact line.
    """
    return max(int(keep * 0.10), 200)


def append_jsonl(
    path: Path, record: dict[str, Any], *, keep: int = JSONL_KEEP_LINES
) -> None:
    """Append one record to a private JSON-lines file and cap the file's length.

    The file is opened 0600 and re-chmodded on every append, because a plain
    `open(path, "a")` under the usual 022 umask produces 0644, and neither of
    these files is one to hand to every account on a shared laptop.  The chmod
    also repairs a file written before this rule existed.

    The append and the trim-decision-and-rewrite both happen inside one
    `flock_guard`, so a concurrent append is never lost to an in-flight trim
    rewriting the file out from under it: the old code's `O_APPEND` write was
    safe against another *append* (one kernel-atomic write each) but not
    against a trim, which reads the whole file and replaces it wholesale --
    a trim that read before a concurrent append's write, then replaced the
    file, silently discarded that append.  The lock removes the race instead
    of relying on how rarely it fires.

    Trimming happens after the append and never before: the line just written is
    the one the operator is about to look up.  A corrupt line still disappears
    for good, since `read_jsonl` drops it and the rewrite does not put it back.
    """
    ensure_private_dir(path.parent, mode=STATE_DIR_MODE)
    with flock_guard(path):
        handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, PRIVATE_FILE_MODE)
        try:
            os.fchmod(handle, PRIVATE_FILE_MODE)
            os.write(handle, (json.dumps(record, sort_keys=True) + "\n").encode("utf-8"))
        finally:
            os.close(handle)
        records = read_jsonl(path)
        if len(records) > keep + _trim_slack(keep):
            write_text_file(
                path,
                "".join(
                    json.dumps(item, sort_keys=True) + "\n" for item in records[-keep:]
                ),
                mode=PRIVATE_FILE_MODE,
            )


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    """Read a JSON-lines state file oldest-first, skipping anything unreadable.

    A ledger that raises is worse than a ledger with a hole in it.  One truncated
    line -- a submit killed mid-write, or two that raced -- must not take
    `fleetctl jobs` and `job status` down with it, so a line that is not a JSON
    object is dropped and the rest of the file stays usable.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    records: list[dict[str, Any]] = []
    for line in text.splitlines():
        try:
            loaded = json.loads(line)
        except ValueError:
            continue
        if isinstance(loaded, dict):
            records.append(loaded)
    return records


def record_submitted_job(paths: FleetPaths, record: dict[str, Any]) -> None:
    """Record one accepted submission, or warn and carry on.

    Nothing here may raise.  This runs after the scheduler has accepted the
    script, so the job already exists: an exception would orphan a real
    allocation for the sake of a line of bookkeeping.  The failure is still worth
    saying out loud -- an operator whose ledger silently stopped growing will
    find out when `job status` asks for flags again -- so it degrades to a
    warning on stderr and leaves the exit code alone.  The allocation is real
    whether or not this file was writable.
    """
    try:
        append_jsonl(jobs_ledger_file(paths), record)
    except Exception as exc:  # noqa: BLE001 -- the job is queued; bookkeeping must not fail submit
        print(
            f"warning: job {record.get('job_id') or '?'} was submitted but could not "
            f"be recorded in {jobs_ledger_file(paths)} ({exc}); `fleetctl job status` "
            "will need --target for it",
            file=sys.stderr,
        )


def apply_job_ledger_defaults(args: argparse.Namespace, context: FleetContext) -> None:
    """Fill in --target and --profile for a job id the ledger already knows.

    `job status 812345` used to demand both flags every time, though the submit
    that created the job knew both and threw them away.  An explicit flag still
    wins: the ledger records where a job went, not where the next command should
    go, and an operator holding a stale ledger needs a way past it.

    An id two targets both claim is a refusal rather than a coin flip.  Two
    clusters really do both have a job 12345, and `job cancel` guessing wrong
    kills a live allocation that belongs to someone else while yours keeps
    running.
    """
    if args.selector and args.profile:
        return
    selector = context.normalize_selector(args.selector)
    matches = [
        record
        for record in read_jsonl(jobs_ledger_file(context.paths))
        if str(record.get("job_id", "")) == args.job_id
        and (selector is None or record.get("target") == selector)
    ]
    if not matches:
        return
    if selector is None:
        claimed = sorted({str(item["target"]) for item in matches if item.get("target")})
        if len(claimed) > 1:
            raise FleetError(
                f"job id {args.job_id!r} was submitted to more than one target "
                f"({', '.join(claimed)}); pass --target to say which one you mean"
            )
    newest = matches[-1]
    recorded_target = str(newest.get("target") or "")
    if not args.selector and recorded_target:
        if recorded_target not in context.targets:
            # The ledger outlives the inventory, so this is a normal end state
            # rather than a corrupt file.  Naming the ledger matters: the operator
            # did not type this target, and "unknown target" about a name they
            # never used reads as a bug in the tool.
            raise FleetError(
                f"the job ledger records job {args.job_id} on target "
                f"{recorded_target!r}, which is no longer in the inventory. Pass "
                "--target to name one that is, or run `fleetctl jobs` to see what "
                "was recorded."
            )
        args.selector = recorded_target
        # On stderr, because `job logs` output gets piped and this is a note about
        # how the command was resolved rather than part of its answer.
        print(
            f"note: --target {recorded_target} resolved from the job ledger",
            file=sys.stderr,
        )
    recorded_profile = str(newest.get("profile") or "")
    # A profile since renamed out of the inventory falls back to normal
    # resolution instead of failing.  That is what this command did before the
    # ledger existed, and the profile is a detail the operator never asked about.
    if not args.profile and recorded_profile in context.profiles:
        args.profile = recorded_profile


def bounded_caller_env() -> str:
    """FLEETCTL_CALLER, cut down to 64 printable characters.

    A caller identity is a controlled, bounded attribution tag a co-resident
    process (fleetq) sets deliberately about *itself* -- categorically not the
    free-form command content `record_invocation`'s docstring below refuses to
    keep. Non-printable bytes are dropped rather than escaped: this runs from
    a `finally` where nothing may raise, and a truncated, filtered string is
    always a legal JSON string value with no further quoting to get wrong.
    """
    raw = os.environ.get("FLEETCTL_CALLER", "")
    return "".join(ch for ch in raw if ch.isprintable())[:64]


def record_invocation(
    args: argparse.Namespace,
    *,
    head: list[str],
    exit_code: int | None,
) -> None:
    """Record that a host was reached for: which verb, which host, what came of it.

    No *operator* string is recorded, and that is the design rather than an
    omission.  A fleetctl command line carries remote paths, script names and,
    after `--`, whatever was pasted into the shell -- which is where a token ends
    up.  A denylist of things to redact is a promise this file cannot keep,
    because the leak is always the flag nobody thought of, and an audit log that
    accumulates the contents of commands has stopped being a record and become a
    secret store.  What lands here is fleetctl's own resolved facts plus the flag
    *names* as typed: enough to answer what a shared cluster's admin asks -- when,
    which host, which verb, did it run or was it refused -- and not enough to
    reconstruct anything.  For `exec` that means knowing a command ran on a login
    node at 14:02 and exited 1, and not what it was.  That is the trade.

    `caller` is the one deliberate exception, and a different kind of field:
    a bounded, printable identity tag (`FLEETCTL_CALLER`) a driving process sets
    about itself, not content lifted from the command line.  fleetq sets it so
    "who submitted this" is answerable without inventing a second audit trail.

    Nothing here may raise and nothing here prints.  This runs from main()'s
    `finally` while a SystemExit carrying the real exit code is already
    propagating, so an exception would replace it with a traceback and the wrong
    status; and a warning would fire on every command rather than once, for a
    broken state directory `doctor` already reports.
    """
    try:
        if not getattr(args, "audited", False):
            return
        plan = getattr(args, "audit_plan", None)
        append_jsonl(
            audit_log_file(
                build_paths(
                    config_home=args.config_home,
                    state_home=args.state_home,
                    cache_home=args.cache_home,
                )
            ),
            {
                "ts": utc_timestamp(),
                "verb": " ".join(
                    part
                    for part in (args.command, getattr(args, "job_command", None))
                    if part
                ),
                # Names only, split at `=` so `--cwd=/srv/customer-42` cannot
                # smuggle its value in as part of one.  A value given as a
                # separate word does not start with `--` and never arrives here.
                "flags": sorted(
                    {token.split("=", 1)[0] for token in head if token.startswith("--")}
                ),
                # Stamped by build_plan above its authorize() call, so a refusal
                # still names the host it was refused on.
                "target": getattr(args, "audit_target", "") or "",
                "role": getattr(args, "audit_role", "") or "",
                # ensure_route writes the route that came up back into the plan,
                # so by the time main() unwinds this is the path traffic took --
                # empty for a refusal, and the first candidate for a dry run,
                # which `dry_run` below distinguishes.
                "route": plan.route if plan is not None else "",
                "admin": bool(getattr(args, "admin", False)),
                "dry_run": bool(getattr(args, "dry_run", False)),
                # None when fleetctl itself died, which is the honest record: we
                # do not know what the remote did.
                "exit": exit_code,
                "caller": bounded_caller_env(),
            },
        )
    except Exception:  # noqa: BLE001 -- auditing runs in main()'s finally and must never raise
        pass


# ---- SECTION: control budget (managed-cluster rate limiting) ---------------
#
# A managed cluster's `[control_budget]` (see ControlBudgetRecord, parsed in
# load_protocols) is enforced in two independent layers, either or both of
# which may apply:
#
#   * a local interim token bucket, entirely on this machine, persisted at
#     $FLEET_STATE_HOME/budget/<canonical_cluster>.json.  It is a per-machine
#     safeguard only -- N fleetctl processes on N different laptops each get
#     their own bucket -- which is why its outcome is always tagged
#     `budget_scope = "local"` rather than implying a fleet-wide guarantee.
#   * a central authority (`authority_url`/`authority_token_file`), consulted
#     first when configured, that can actually coordinate across every caller.
#     It fails closed: unreachable, slow, or answering nonsense all deny.
#
# Both raise BudgetRefused on denial, which every verb's caller lets surface as
# an ordinary FleetError (exit_code=75) or, under `--json`, the
# `budget_refused` outcome -- no separate handling needed at either call site.

AUTHORITY_TIMEOUT = 5.0


def control_budget_state_file(paths: FleetPaths, canonical: str) -> Path:
    """Where CANONICAL's local token-bucket state is persisted."""
    return paths.state_home / "budget" / f"{canonical}.json"


def load_control_budget_state(path: Path) -> dict[str, float]:
    """Read one bucket's persisted token state, conservatively.

    Missing, corrupt, or otherwise unreadable -> {"tokens": 0.0, "updated":
    now}, never a full burst.  "A restart must not refill them to a full
    burst" is read as: a bucket that cannot prove it has tokens saved up
    starts as though it has none, and earns them back at the declared rate
    like anything else -- an absent file must never look like "fully rested"
    to whatever reads it, or deleting it would be a free burst.
    """
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
        tokens = float(loaded["tokens"])
        updated = float(loaded["updated"])
        if not math.isfinite(tokens) or tokens < 0 or not math.isfinite(updated):
            raise ValueError("non-finite or negative bucket state")
        return {"tokens": tokens, "updated": updated}
    except (OSError, ValueError, KeyError, TypeError):
        return {"tokens": 0.0, "updated": time.time()}


def _budget_rate(budget: ControlBudgetRecord, op_class: str) -> float | None:
    """Tokens per second for OP_CLASS, or None when the site set no limit for it."""
    per_minute = {
        "monitor": budget.monitor_per_minute,
        "action": budget.action_per_minute,
        "transfer": budget.transfer_per_minute,
    }.get(op_class)
    if per_minute is None:
        return None
    return per_minute / 60.0


def local_sync_source_bytes(value: str) -> int:
    """Count a local sync source without following symlinks or special files."""
    root = Path(value).expanduser().resolve(strict=True)
    total = 0
    paths = [root]
    if root.is_dir():
        paths = []
        def walk_error(exc: OSError) -> None:
            raise exc

        for directory, dirs, files in os.walk(
            root, followlinks=False, onerror=walk_error
        ):
            base = Path(directory)
            paths.extend(base / name for name in dirs)
            paths.extend(base / name for name in files)
    for path in paths:
        info = path.lstat()
        if stat.S_ISREG(info.st_mode):
            total += info.st_size
        elif stat.S_ISLNK(info.st_mode):
            total += len(os.fsencode(os.readlink(path)))
        elif stat.S_ISDIR(info.st_mode):
            continue
        else:
            raise FleetError(f"cannot safely budget sync source special file: {path}")
        if total > MAX_SYNC_BUDGET_BYTES:
            raise FleetError(
                f"sync source exceeds the {MAX_SYNC_BUDGET_BYTES}-byte budget ceiling"
            )
    return total


def sync_budget_bytes(args: argparse.Namespace) -> int:
    """Return the central byte cost; remote source sizes require an explicit ceiling."""
    supplied = getattr(args, "budget_bytes", None)
    if supplied is not None and (supplied < 0 or supplied > MAX_SYNC_BUDGET_BYTES):
        raise FleetError(
            f"--budget-bytes must be between 0 and {MAX_SYNC_BUDGET_BYTES}"
        )
    if args.direction == "push":
        measured = local_sync_source_bytes(args.local_path)
        if supplied is not None and supplied < measured:
            raise FleetError(
                f"--budget-bytes ({supplied}) is below the local source size ({measured})"
            )
        return measured if supplied is None else supplied
    if supplied is None:
        raise BudgetRefused(
            "centrally budgeted pull/transfer needs an explicit --budget-bytes ceiling",
            scope="central",
            reason="cost_unknown",
        )
    return supplied


def central_sync_budget_bytes(args: argparse.Namespace, *plans: "Plan") -> int | None:
    """Compute one ceiling when any participating endpoint uses central authority."""
    if any(
        plan.protocol.control_budget is not None
        and plan.protocol.control_budget.authority_url
        and plan.protocol.control_budget.authority_token_file
        for plan in plans
    ):
        return sync_budget_bytes(args)
    return None


def verify_sync_source_within_budget(args: argparse.Namespace, allowance: int) -> None:
    """Recheck push sources immediately before transport to catch observable growth."""
    if args.direction == "push":
        measured = local_sync_source_bytes(args.local_path)
        if measured > allowance:
            raise FleetError(
                f"local sync source grew to {measured} bytes, above its "
                f"{allowance}-byte budget ceiling"
            )


def acquire_local_budget(
    paths: FleetPaths,
    budget: ControlBudgetRecord,
    op_class: str,
    *,
    wait: float = 0.0,
) -> dict[str, Any]:
    """Spend one token from BUDGET's OP_CLASS bucket, or raise BudgetRefused.

    The read, refill, grant-or-deny decision and write are one `flock_guard`
    per attempt, so two processes charging the same bucket at once cannot both
    read the same starting balance and both believe they spent the last token.
    WAIT, when given, retries -- sleeping the estimated retry_after each time,
    bounded by what is left of WAIT -- rather than busy-spinning inside the
    lock, which would starve every other process sharing the bucket.  A wall-
    clock step backwards mints no tokens: elapsed time since the last write is
    clamped to zero rather than allowed to go negative.
    """
    rate = _budget_rate(budget, op_class)
    path = control_budget_state_file(paths, budget.canonical_cluster)
    burst = budget.burst if budget.burst is not None else 1.0
    deadline = time.monotonic() + max(wait, 0.0)
    while True:
        with flock_guard(path):
            state = load_control_budget_state(path)
            now = time.time()
            elapsed = max(0.0, now - state["updated"])
            tokens = state["tokens"]
            if rate is not None:
                tokens = min(burst, tokens + elapsed * rate)
            if rate is None or tokens >= 1.0:
                spent = tokens - 1.0 if rate is not None else tokens
                write_json_atomic(
                    path, {"tokens": max(spent, 0.0), "updated": now}, mode=PRIVATE_FILE_MODE
                )
                return {"budget_scope": "local"}
            retry_after = (1.0 - tokens) / rate
            write_json_atomic(
                path, {"tokens": tokens, "updated": now}, mode=PRIVATE_FILE_MODE
            )
        remaining = deadline - time.monotonic()
        if remaining <= 0 or retry_after > remaining:
            raise BudgetRefused(
                f"control budget exhausted for {budget.canonical_cluster!r} "
                f"({op_class}); retry in {retry_after:.1f}s",
                scope="local",
                retry_after=retry_after,
            )
        time.sleep(min(retry_after, remaining))


def resolve_op_class(verb: str, args: argparse.Namespace) -> str:
    """The control-budget operation class VERB (and, for `exec`, `--op-class`) charges.

    `submit` and `job cancel` are "action"; `job status` is "monitor" (it only
    reads); `sync` is "transfer".  `exec --admin` against a budget-carrying
    protocol asks the operator to say which of the three it is via
    `--op-class`; left unset, it charges the conservative default, "action".
    """
    if verb == "job":
        return "monitor" if getattr(args, "job_command", None) == "status" else "action"
    if verb == "sync":
        return "transfer"
    if verb == "submit":
        return "action"
    if verb == "exec":
        return getattr(args, "op_class", None) or "action"
    return "action"


def authority_headers(token_file: str) -> dict[str, str]:
    """Authorization header built from a bearer token read out of TOKEN_FILE."""
    token = Path(token_file).expanduser().read_text(encoding="utf-8").strip()
    return {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}


def _authority_post(
    url: str, token_file: str, body: dict[str, Any], *, timeout: float
) -> dict[str, Any] | None:
    """POST BODY as JSON to URL with a bearer token; None on any failure at all.

    Deny-by-default lives here: an unreachable authority, a slow one (past
    TIMEOUT), a non-200 status, or a body that is not the JSON object it
    should be all collapse to the same None, and every caller treats None as
    "the authority did not grant this" without needing to tell those apart --
    urllib.request only, per the task (no third-party HTTP client).
    """
    try:
        headers = authority_headers(token_file)
    except OSError:
        return None
    request = urllib.request.Request(
        url, data=json.dumps(body).encode("utf-8"), headers=headers, method="POST"
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            if response.status != 200:
                return None
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, ValueError, OSError):
        return None
    return payload if isinstance(payload, dict) else None


def authority_request_permit(
    authority_url: str,
    token_file: str,
    *,
    cluster: str,
    op_class: str,
    caller: str,
    cost: dict[str, int] | None = None,
    timeout: float = AUTHORITY_TIMEOUT,
) -> dict[str, Any]:
    """POST {authority_url}/api/v1/permits; return the grant, or raise BudgetRefused.

    `{"granted": false, "retry_after": s}` is a stated denial; anything else
    that is not a clean `{"granted": true, "permit_id": ...}` -- unreachable,
    timed out, a bad status, unparsable JSON, or a granted response missing
    its permit_id -- is deny-by-default, tagged reason="authority_unavailable"
    since it is not the authority's own stated reason.
    """
    body = {
        "cluster": cluster,
        "op_class": op_class,
        "cost": cost or {"rpc": 1, "sessions": 1, "bytes": 0},
        "caller": caller,
    }
    payload = _authority_post(
        f"{authority_url}/api/v1/permits", token_file, body, timeout=timeout
    )
    if payload is not None and payload.get("granted") is True and payload.get("permit_id"):
        return payload
    if payload is not None and payload.get("granted") is False:
        raise BudgetRefused(
            f"control authority denied a permit for {cluster!r} ({op_class})",
            scope="central",
            retry_after=optional_float(payload.get("retry_after")),
            reason="denied",
        )
    raise BudgetRefused(
        f"control authority for {cluster!r} is unreachable or returned an unusable answer",
        scope="central",
        reason="authority_unavailable",
    )


def authority_redeem_permit(
    authority_url: str,
    token_file: str,
    permit_id: str,
    *,
    cluster: str,
    op_class: str,
    cost: dict[str, int] | None = None,
    timeout: float = AUTHORITY_TIMEOUT,
) -> bool:
    """POST {authority_url}/api/v1/permits/<id>/redeem; True only on `{"valid": true}`
    for exactly CLUSTER and OP_CLASS.

    Every failure mode _authority_post already collapses to None is, again,
    deny-by-default here: a permit that cannot be confirmed redeemed is not
    treated as redeemed.  The permit names the bucket it was drawn from, so a
    monitor permit for one cluster never pays for an action on another.
    """
    payload = _authority_post(
        f"{authority_url}/api/v1/permits/{permit_id}/redeem",
        token_file,
        {"cluster": cluster, "op_class": op_class, "cost": cost or {"rpc": 1, "sessions": 1, "bytes": 0}},
        timeout=timeout,
    )
    return bool(
        payload is not None
        and payload.get("valid") is True
        and payload.get("cluster") == cluster
        and payload.get("op_class") == op_class
    )


def enforce_control_budget(
    plan: "Plan",
    args: argparse.Namespace,
    verb: str,
    *,
    byte_cost: int | None = None,
    session_cost: int | None = None,
) -> dict[str, Any]:
    """Acquire a control-budget permit for VERB against PLAN's protocol, if it carries one.

    A no-op ({}) when the protocol declares no `[control_budget]`.  Otherwise,
    before anything connects: if a co-resident scheduler already holds a
    permit (`FLEETCTL_PERMIT` in the environment), redeem it rather than
    request a fresh one; else, when the site configures a central authority,
    ask it; else fall back to the local interim bucket.  Raises BudgetRefused
    on denial -- callers do not need to catch it specially, it is a FleetError
    with exit_code=75, so it already prints and exits correctly through the
    same path every other refusal does, and `--json` classifies it as
    `budget_refused` the same way it classifies any other exception raised
    before a connection is attempted.
    """
    budget = plan.protocol.control_budget
    if budget is None:
        return {}
    op_class = resolve_op_class(verb, args)
    if verb == "exec" and getattr(args, "op_class", None) is None:
        print(
            f"note: {plan.target.name!r}'s protocol carries a control budget and "
            "`exec` named no --op-class; charging the conservative default, "
            "'action'",
            file=sys.stderr,
        )
    caller = bounded_caller_env() or "fleetctl"
    if budget.authority_url and budget.authority_token_file:
        cost = {
            "rpc": {"submit": 12, "job": 6, "exec": 8, "script": 8, "sync": 6}.get(verb, 4),
            "sessions": session_cost
            if session_cost is not None
            else {"submit": 3, "job": 2, "exec": 2, "script": 2, "sync": 3}.get(verb, 2),
            "bytes": (sync_budget_bytes(args) if byte_cost is None else byte_cost)
            if verb == "sync"
            else 0,
        }
        held_permit = os.environ.get("FLEETCTL_PERMIT")
        if held_permit:
            if not authority_redeem_permit(
                budget.authority_url,
                budget.authority_token_file,
                held_permit,
                cluster=budget.canonical_cluster,
                op_class=op_class,
                cost=cost,
            ):
                raise BudgetRefused(
                    f"held permit {held_permit!r} was not valid for "
                    f"{budget.canonical_cluster!r}",
                    scope="central",
                    reason="permit_invalid",
                )
            return {"budget_scope": "central", "permit_id": held_permit}
        granted = authority_request_permit(
            budget.authority_url,
            budget.authority_token_file,
            cluster=budget.canonical_cluster,
            op_class=op_class,
            caller=caller,
            cost=cost,
        )
        return {"budget_scope": "central", "permit_id": granted.get("permit_id")}
    wait = float(getattr(args, "budget_wait", None) or 0.0)
    return acquire_local_budget(plan.context.paths, budget, op_class, wait=wait)


def bring_up_control_master(
    secret: FleetSecret, runtime: dict[str, Any], route: str
) -> str | None:
    """Make sure RUNTIME's master over ROUTE is live; return why not, or None.

    One definition of failure, shared by the selector and by `doctor --probe`, so
    the two cannot disagree about which routes carry.  The second check is the
    race: two fleetctl processes reaching one host over one route both try to
    open it, `ControlMaster=yes` fails the loser, and the socket the loser lost to
    is the master it wanted.  Reading that as a failure moved the command onto the
    bridge while a perfectly good direct master sat there serving the winner.
    """
    if control_master_alive(secret, runtime):
        return None
    failure = open_control_master(secret, runtime, route)
    if failure is None:
        return None
    return None if control_master_alive(secret, runtime) else failure


def establish_hop(
    context: FleetContext, bridge_name: str, *, chain: tuple[str, ...] = ()
) -> str | None:
    """Bring up the master a hop through BRIDGE_NAME will ride on.

    A bridge is reached the way anything else is -- its own `reach`, in declared
    order, through the one function that owns route selection.  It used not to be:
    the hop was rendered against the bridge's `reach[0]` and the ProxyCommand's
    own ssh brought that master up as a side effect, so a bridge's fallback was
    unreachable in the one situation it was declared for, and a bridge whose
    direct path was down took every host behind it down with it.

    Returns None when the hop is ready, or why it is not.  The reasons are the
    bridge's own, because "the bridge came up on no route" and "the destination
    is not visible from the bridge" are different faults with different fixes.
    """
    if bridge_name in chain:
        raise FleetError("reach cycle: " + " -> ".join((*chain, bridge_name)))
    bridge = context.targets.get(bridge_name)
    if bridge is None:
        raise FleetError(
            f"route names unknown target {bridge_name!r}; run `fleetctl list`"
        )
    ensure_target_enabled(bridge)
    route, failures = establish_route(
        context,
        bridge,
        context.resolve_secret(bridge),
        bridge.reach or DEFAULT_REACH,
        chain=chain,
    )
    if route is not None:
        return None
    return f"bridge {bridge_name!r} came up on no route: " + ", ".join(failures)


def establish_route(
    context: FleetContext,
    target: TargetRecord,
    secret: FleetSecret,
    routes: tuple[str, ...],
    *,
    chain: tuple[str, ...] = (),
) -> tuple[str | None, list[str]]:
    """Bring up a master for the first of ROUTES that works, and report the rest.

    Selection happens once per socket, not once per command.  A warm master means
    the route was chosen already and is still carrying traffic, so nothing is
    re-probed and preferring the direct path costs nothing; when the socket is
    cold each declared route is tried in order and the first master to come up
    wins, which is what makes `reach` a fallback list rather than a wish.

    Every step of an attempt is inside the same `try`, and that is the repair
    this function exists for.  `ssh -O check` against a hung master times out and
    raises, an over-long ControlPath raises, a bridge that is disabled or
    password-authenticated raises -- and a raise out of this loop skipped every
    remaining route, so fallback was lost in precisely the state it exists for: a
    direct master wedged rather than absent.  A route that cannot be attempted is
    a route that did not come up, reported by name like any other.

    Fallback lives here and nowhere else, deliberately.  Once a master exists a
    failing command is a failing command -- never retried, never re-routed --
    because `exec` and `submit` are at-most-once and a re-routed `sbatch` queues
    the job twice.  A retry added anywhere outside this function takes that
    guarantee away.
    """
    failures: list[str] = []
    for route in routes or DEFAULT_REACH:
        try:
            bridge_name = route_bridge(route)
            if bridge_name is not None:
                # Before the destination, so the hop rides a master this code path
                # owns rather than one the ProxyCommand opens behind its back.
                hop_failure = establish_hop(
                    context, bridge_name, chain=(*chain, target.name)
                )
                if hop_failure is not None:
                    failures.append(f"{route} ({hop_failure})")
                    continue
            runtime = ssh_runtime_kwargs(context, target=target, route=route)
            failure = bring_up_control_master(secret, runtime, route)
        except FleetError as exc:
            failures.append(f"{route} ({exc})")
            continue
        if failure is None:
            context.route_established[target.name] = route
            record_route_state(
                context.paths, target.name, route, str(runtime["control_path"])
            )
            return route, failures
        failures.append(f"{route} ({failure})")
    return None, failures


def route_fallback_hint(plan: Plan) -> str:
    """Say what else there was to try, which is two different answers.

    A suppressed fallback and a missing one produce the same failure and want
    opposite fixes, and the hint was gated on the declared list alone -- so
    `--no-fallback` against a host with a perfectly good bridge was told to go
    declare the bridge it already had.
    """
    declared = plan.target.reach or DEFAULT_REACH
    untried = tuple(route for route in declared if route not in plan.routes)
    if untried:
        return (
            f" `--route`/`--no-fallback` narrowed this run to "
            f"[{format_reach(plan.routes)}], so the declared "
            f"[{format_reach(untried)}] was not tried."
        )
    if len(declared) < 2:
        return (
            " Declare a `via:<bridge>` fallback in that target's `reach` if a "
            "bridge can carry it."
        )
    return ""


def ensure_route(plan: Plan) -> str:
    """Bring up a control master for the first of PLAN's routes that works.

    The Plan-shaped door onto establish_route, which is where the ordering and
    the at-most-once argument live.  Memoised on the plan as well as in the
    context, so one command asks once.
    """
    if plan._route is not None:
        return plan._route
    if not base_ssh_runtime_kwargs(plan.context)["control_path"]:
        # Multiplexing is off, so there is no master to establish and no socket to
        # check.  Fallback is a property of the master, not of the command.
        return plan.route
    route, failures = establish_route(
        plan.context, plan.target, plan.secret, plan.routes
    )
    if route is not None:
        object.__setattr__(plan, "_route", route)
        return route
    raise FleetError(
        f"no route to {plan.target.name!r} came up; tried "
        + ", ".join(failures)
        + "."
        + route_fallback_hint(plan)
    )


TEMPLATE_PLACEHOLDER = re.compile(r"\{(script|job_id|workdir)\}")


def render_template_values(
    values: Iterable[str],
    *,
    script_path: str | None = None,
    job_id: str | None = None,
    workdir: str | None = None,
) -> list[str]:
    """Render `{script}`, `{job_id}` and `{workdir}` placeholders in argv templates.

    Deliberately not `str.format`: these templates come from config, and a literal
    brace -- an awk program, a `${VAR}`, a JSON fragment -- raised at render time,
    while an unrecognised `{name}` raised KeyError instead of being left alone.
    """
    substitutions = {
        "script": script_path or "",
        "job_id": job_id or "",
        "workdir": workdir or "",
    }
    return [
        TEMPLATE_PLACEHOLDER.sub(lambda match: substitutions[match.group(1)], value)
        for value in values
    ]


def quote_remote_path(path: str) -> str:
    """Quote a fleet-resolved remote path, keeping a leading `~/` expandable.

    `shlex.quote("~/work")` yields `'~/work'`, and no shell expands a quoted
    tilde, so every `~`-relative workdir failed with "remote cwd not found".
    Emitting `$HOME` unquoted with the remainder quoted keeps the expansion while
    staying safe for paths containing spaces or quotes.
    """
    if path in ("~", "$HOME"):
        return "$HOME"
    for prefix in ("~/", "$HOME/"):
        if path.startswith(prefix):
            remainder = path[len(prefix) :]
            return f"$HOME/{shlex.quote(remainder)}" if remainder else "$HOME"
    return shlex.quote(path)


# A staging directory is named by exactly `secrets.token_hex(STAGE_TOKEN_BYTES)`,
# and the collector below matches that shape rather than `*`.  Both constants live
# here so the name a script is staged under and the glob that deletes it cannot
# drift apart.
STAGE_TOKEN_BYTES = 8
STAGE_TOKEN_GLOB = "[0-9a-f]" * (STAGE_TOKEN_BYTES * 2)
STAGE_RETENTION_DAYS = 14


def validate_remote_script_root(configured_root: str, remote_root: str) -> str:
    """Return a normalized, dedicated staging root or refuse the profile value.

    Staging cleanup uses recursive deletion, so its parent must be an explicitly
    dedicated fleet script directory. `configured_root` is checked for shell/path
    aliases before expansion; `remote_root` is its resolved remote path.
    """
    validate_configured_script_root(configured_root)
    if not remote_root.startswith("/"):
        raise FleetError("remote_script_root must resolve to an absolute remote path")
    root = posixpath.normpath(remote_root)
    if not root.endswith("/fleet/scripts"):
        raise FleetError("remote_script_root must be a dedicated path ending in /fleet/scripts")
    forbidden = ("/tmp", "/var/tmp", "/proc", "/sys", "/dev", "/etc", "/usr", "/bin", "/sbin", "/lib", "/boot")
    if any(root == path or root.startswith(path + "/") for path in forbidden):
        raise FleetError("remote_script_root may not be under a temporary or protected system directory")
    return root


def validate_configured_script_root(configured_root: str) -> None:
    """Reject path syntax that could trigger needless remote resolution."""
    if not configured_root or any(c in configured_root for c in ("$", "`", "\\", "\n", "\r")):
        raise FleetError("remote_script_root must be a literal dedicated path ending in /fleet/scripts")
    if configured_root.startswith("~"):
        raise FleetError("remote_script_root does not allow home-directory aliases")
    if ".." in configured_root.split("/"):
        raise FleetError("remote_script_root must not contain parent-directory components")


def stage_prune_command(remote_root: str, remote_dir: str) -> str:
    """Build the one command that makes a staging directory and collects old ones.

    Nothing has ever removed a staged script, and `submit` leaves two per job.
    The collector therefore rides the `mkdir` staging already pays for: staging
    is on the path of every single command, `submit` stages twice, and one host in
    this fleet is reached through a Raspberry Pi, where a separate prune would be
    two more round trips of real latency per submission.  What it actually costs
    is one `find` over a single directory level.

    Age comes from the remote `find`'s own view of mtime, because there is no
    agent on the far side and a staging directory's mtime already *is* the moment
    its script was written -- nothing touches it again.  The alternative, encoding
    a timestamp in the name, would need an `ls` round trip to read the names back.

    `mkdir` keeps its own failure, so the caller's "failed to create remote script
    directory" still fires; everything the collector says or returns is discarded.
    A stale directory nobody has permission to remove must never be the reason a
    submit did not happen.

    `-name` matches the exact shape of a fleet staging token rather than `*`: a
    profile whose `remote_script_root` pointed somewhere shared would otherwise
    hand `rm -rf` to whatever else lived there.  The cost is that directories
    staged before this change are 8 characters of `[a-z0-9_]` and never match, so
    they need one manual sweep -- which is the right trade against permanently
    weakening the only thing keeping this honest.
    """
    remote_root = validate_remote_script_root(remote_root, remote_root)
    token = posixpath.basename(remote_dir)
    if (
        posixpath.dirname(posixpath.normpath(remote_dir)) != remote_root
        or not re.fullmatch(STAGE_TOKEN_GLOB, token)
    ):
        raise FleetError("remote staging directory must be a token child of remote_script_root")
    collect = shlex.join(
        [
            "find",
            remote_root,
            "-mindepth", "1",
            "-maxdepth", "1",
            "-type", "d",
            "-name", STAGE_TOKEN_GLOB,
            "-mtime", f"+{STAGE_RETENTION_DAYS}",
            "-exec", "rm", "-rf", "{}", "+",
        ]
    )
    return shlex.join(
        [
            "/bin/sh",
            "-c",
            f"mkdir -p {quote_remote_path(remote_dir)} || exit 1; "
            f"{collect} >/dev/null 2>&1; exit 0",
        ]
    )


def remote_shell_path_command(argv: list[str], remote_path: str) -> str:
    """Build a remote command whose final argument is a fleet-resolved path."""
    return shlex.join(
        ["/bin/sh", "-c", f"{shlex.join(argv)} {quote_remote_path(remote_path)}"]
    )


def remote_shell_command(command: list[str], *, cwd: str | None = None) -> str:
    """Build a remote shell command from argv."""
    inner = shlex.join(command)
    if cwd:
        quoted_cwd = quote_remote_path(cwd)
        inner = (
            f"if [ -d {quoted_cwd} ]; then cd {quoted_cwd};"
            f" else printf 'error: remote cwd not found: %s\\n' {quoted_cwd} >&2;"
            " exit 1; fi;"
            f" {inner}"
        )
    return shlex.join(["/bin/sh", "-c", inner])


def remote_posix_join(base: str, name: str) -> str:
    """Join remote POSIX paths while preserving `~` prefixes."""
    if base.startswith("~/"):
        return "~/" + posixpath.join(base[2:], name)
    return posixpath.join(base, name)


def resolve_remote_path(value: str, *, base: str | None) -> str:
    """Resolve one operator-supplied remote path against BASE.

    Absolute stays absolute, `~/...` stays home-relative, and anything else
    hangs off the target's remote root.  The call sites used to disagree: `sync`
    read a relative remote path as remote-$HOME-relative while job output paths
    read the same spelling as project-relative, so `--remote-path logs` and
    `--output logs/run.out` named two different directories on one host in one
    command.
    """
    if value.startswith("/") or value == "~" or value.startswith("~/"):
        return value
    if base is None:
        return value
    return remote_posix_join(base, value)


def scp_remote_path(path: str) -> str:
    """Normalize a remote path for scp/sftp transports."""
    if path.startswith("~/"):
        return path[2:]
    return path


def resolve_remote_home(
    secret: FleetSecret,
    *,
    ssh_runtime: dict[str, Any] | None = None,
) -> str:
    """Resolve the remote user's home directory."""
    completed = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=shlex.join(["/bin/sh", "-c", 'printf "%s" "$HOME"']),
        capture_output=True,
        timeout=CONTROL_COMMAND_TIMEOUT,
        **(ssh_runtime or {}),
    )
    home = completed.stdout.strip()
    if completed.returncode != 0 or not home:
        raise FleetError(f"failed to resolve remote home directory on {secret.target}")
    return home


def stage_remote_script(
    secret: FleetSecret,
    profile: ProfileRecord,
    local_script: Path,
    *,
    ssh_runtime: dict[str, Any] | None = None,
) -> str:
    """Copy one local script into a remote scratch directory and return its path."""
    script_name = local_script.name
    token = secrets.token_hex(STAGE_TOKEN_BYTES)
    ssh_runtime = ssh_runtime or {}
    configured_root = profile.remote_script_root
    validate_configured_script_root(configured_root)
    remote_root = configured_root
    if not remote_root.startswith("/"):
        remote_home = resolve_remote_home(secret, ssh_runtime=ssh_runtime)
        remote_root = posixpath.join(remote_home, remote_root)
    remote_root = validate_remote_script_root(configured_root, remote_root)
    remote_dir = remote_posix_join(remote_root, token)
    remote_path = remote_posix_join(remote_dir, script_name)

    mkdir = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=stage_prune_command(remote_root, remote_dir),
        timeout=CONTROL_COMMAND_TIMEOUT,
        **ssh_runtime,
    )
    if mkdir.returncode != 0:
        raise FleetError(
            f"failed to create remote script directory {remote_dir!r} on "
            f"{secret.target}"
        )

    scp = run_command(
        build_scp_command(
            secret,
            source=str(local_script),
            dest=f"{secret.target}:{scp_remote_path(remote_path)}",
            **ssh_runtime,
        ),
        env=ssh_env(secret),
        timeout=CONTROL_COMMAND_TIMEOUT,
    )
    if scp.returncode != 0:
        raise FleetError(
            f"failed to upload {local_script} to {secret.target}:{remote_path}"
        )

    chmod = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=remote_shell_path_command(["chmod", "700"], remote_path),
        timeout=CONTROL_COMMAND_TIMEOUT,
        **ssh_runtime,
    )
    if chmod.returncode != 0:
        raise FleetError(
            f"failed to chmod remote script {remote_path!r} on {secret.target}"
        )
    return remote_path


def prefixed_env_command(
    argv: list[str],
    environment: dict[str, str],
) -> list[str]:
    """Prefix one argv vector with `/usr/bin/env` assignments when needed."""
    if not environment:
        return argv
    assignments = [f"{key}={value}" for key, value in sorted(environment.items())]
    return ["/usr/bin/env", *assignments, *argv]


def ensure_remote_directory(
    secret: FleetSecret,
    remote_path: str,
    *,
    ssh_runtime: dict[str, Any] | None = None,
) -> None:
    """Create one remote directory or raise a fleet error."""
    mkdir = run_ssh_command(
        secret,
        allocate_tty=False,
        remote_command=remote_shell_path_command(["mkdir", "-p"], remote_path),
        timeout=CONTROL_COMMAND_TIMEOUT,
        **(ssh_runtime or {}),
    )
    if mkdir.returncode != 0:
        raise FleetError(
            f"failed to create remote directory {remote_path!r} on {secret.target}"
        )


def protocol_base_root(
    target: TargetRecord,
    binding: ProjectBinding | None,
    override: str | None = None,
) -> str | None:
    """Resolve the most specific remote root available for logs and jobs."""
    return override or resolve_remote_root(target, binding) or target.workdir


def resolve_job_output_paths(
    protocol: ProtocolRecord,
    *,
    base_root: str | None,
    output_override: str | None,
    error_override: str | None,
) -> tuple[str | None, str | None, str | None]:
    """Resolve absolute stdout/stderr paths for one job submission."""
    if base_root is None and (output_override is None or error_override is None):
        return None, None, None
    output_dir: str | None = None
    if base_root is not None:
        output_dir = resolve_remote_path(protocol.job_output_dir, base=base_root)

    def resolve_one(value: str | None, fallback_name: str) -> str | None:
        if value is None:
            if output_dir is None:
                return None
            return remote_posix_join(output_dir, fallback_name)
        return resolve_remote_path(value, base=base_root)

    output_path = resolve_one(output_override, "%j.out")
    error_path = resolve_one(error_override, "%j.err")
    return output_dir, output_path, error_path


def job_ledger_record(plan: Plan, local_script: Path) -> dict[str, Any]:
    """Describe one submission for the ledger, minus the id only the scheduler knows.

    Every field comes off the frozen plan, so the ledger records the target,
    protocol, profile and queue the submit actually used instead of a second
    resolution of the same arguments.  `script` is the local path submitted, not
    the staged remote one: the staged copy is a directory the collector removes.

    Absent values are `""` and never null, so a record renders through
    `format_table` without the word "None" appearing in a column.
    """
    return {
        "ts": utc_timestamp(),
        "target": plan.target.name,
        "protocol": plan.protocol.name,
        "profile": plan.profile.name,
        "queue": plan.queue.name if plan.queue is not None else "",
        "job_id": "",
        "script": str(local_script),
        "log_out": "",
        "log_err": "",
        "cwd": plan.cwd or "",
    }


def sanitize_job_name(value: str) -> str:
    """Produce a scheduler-safe job name."""
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-")
    return cleaned[:128] or "fleet-job"


def resolve_queue(
    protocol: ProtocolRecord,
    requested: str | None,
    *,
    target_capabilities: dict[str, Any] | None = None,
    requirements: tuple[Requirement, ...] = (),
    fit: bool = False,
) -> QueueRecord:
    """Resolve one queue preset from a protocol.

    Requirements filter the partitions, because on a scheduler the hardware a job
    gets is the partition's rather than the login node's.  `--fit` then takes the
    smallest sufficient one, so a single-GPU job stops booking the eight-GPU
    partition.  With neither flag this is exactly the old rule: the declared
    default, else the first declared.
    """
    base = dict(target_capabilities or {})

    def surface(queue: QueueRecord) -> dict[str, Any]:
        merged = dict(base)
        merged.update(queue.capabilities)
        return merged

    wanted = " ".join(str(item) for item in requirements)
    if requested:
        queue = protocol.queue_named(requested)
        if queue is None:
            raise FleetError(
                f"protocol {protocol.name!r} does not define queue {requested!r}"
            )
        mismatches = capability_mismatches(requirements, surface(queue))
        if mismatches:
            raise FleetError(
                f"queue {queue.name!r} does not satisfy {wanted}: "
                f"{'; '.join(mismatches)}"
            )
        return queue
    candidates = [
        queue
        for queue in protocol.queues
        if not capability_mismatches(requirements, surface(queue))
    ]
    if not candidates:
        if not protocol.queues:
            raise FleetError(
                f"protocol {protocol.name!r} does not define a default queue"
            )
        detail = "\n".join(
            f"  {queue.name}: "
            f"{'; '.join(capability_mismatches(requirements, surface(queue)))}"
            for queue in protocol.queues
        )
        raise FleetError(
            f"no queue on protocol {protocol.name!r} satisfies {wanted}:\n{detail}"
        )
    if fit:
        return min(
            candidates, key=lambda queue: (capability_cost(surface(queue)), queue.name)
        )
    for queue in candidates:
        if queue.default:
            return queue
    return candidates[0]


def slurm_gpu_directive(
    protocol: ProtocolRecord,
    queue: QueueRecord,
    requested_gpus: int | None,
) -> str | None:
    """Resolve the scheduler GPU directive line."""
    if protocol.gpu_request_mode == "none":
        return None
    gpu_count = requested_gpus if requested_gpus is not None else queue.gpus
    if protocol.gpu_request_mode == "gpus":
        if gpu_count is None:
            return None
        return f"#SBATCH --gpus={gpu_count}"
    if protocol.gpu_request_mode == "gres":
        gres = queue.gres
        if gres is None and gpu_count is not None:
            gres = f"gpu:{gpu_count}"
        if gres is None:
            return None
        return f"#SBATCH --gres={gres}"
    raise FleetError(
        f"unsupported gpu_request_mode {protocol.gpu_request_mode!r} in "
        f"protocol {protocol.name!r}"
    )


INLINE_PAYLOAD_MAX_BYTES = 64 * 1024


def payload_fits_inline(local_script: Path) -> bool:
    """Whether LOCAL_SCRIPT is small enough to embed in the wrapper instead of
    being staged as its own remote file.

    Below the cap, only the wrapper is ever staged (see render_inline_payload_lines
    and command_submit's queue path), which saves a round trip and makes a job
    that pends for a long time immune to the 14-day stage prune (STAGE_RETENTION_DAYS)
    -- there is no separately-staged payload directory for the prune to catch.
    """
    try:
        return local_script.stat().st_size <= INLINE_PAYLOAD_MAX_BYTES
    except OSError:
        return False


def render_inline_payload_lines(
    payload: bytes, *, interpreter: str | None, script_args: list[str]
) -> list[str]:
    """Render the wrapper tail that embeds PAYLOAD instead of referencing a staged path.

    The delimiter is `FLEETCTL_PAYLOAD_<32 hex>_END`, freshly random per render,
    so it can never collide with a delimiter some other render picked. It also
    can never collide with anything inside the payload's own base64 encoding,
    because that encoding's alphabet (`A-Za-z0-9+/=`) contains no underscore --
    checked below rather than trusted, since a silent collision would corrupt
    the payload rather than fail loudly.

    The heredoc is quoted (`<<'DELIM'`), which is what makes embedding the
    payload a safe literal: nothing between the delimiters is expanded by the
    shell reading it, regardless of whether the base64 text happened to
    contain a quote, a `$VAR`, a backtick, or -- the reason the delimiter is
    random rather than fixed -- the literal line "EOF". `mktemp` names the
    private temp file (so it cannot collide with a concurrent job's own),
    `chmod 700` runs before anything is written to it, and the `trap` removes
    it on exit unconditionally -- normal completion, an early failure under
    `set -e`, or scancel's SIGTERM all still clean it up (dash skips EXIT traps
    on an untrapped signal, hence the explicit HUP/INT/TERM traps that turn
    each into an ordinary exit with the conventional 128+N code). The trap only ever
    deletes a file, so it never touches `$?`; the payload's own exit code
    reaches the scheduler as the wrapper's own, via the explicit `exit $?` --
    which is also what still runs it if `set -e` does not itself abort first
    (namely: the payload's own exit is 0).
    """
    delimiter = f"FLEETCTL_PAYLOAD_{secrets.token_hex(16)}_END"
    encoded = base64.b64encode(payload).decode("ascii")
    assert "_" not in encoded, "base64 output must never contain '_' (delimiter safety)"
    body = [encoded[i : i + 76] for i in range(0, len(encoded), 76)]
    argv_tokens: list[str] = []
    if interpreter:
        argv_tokens.extend(shlex.quote(token) for token in shlex.split(interpreter))
    # Deliberately not run through shlex.quote/shlex.join: it is a shell
    # variable reference that must still expand, just double-quoted against
    # word-splitting and globbing -- shlex.quote would instead single-quote it
    # into inert literal text.
    argv_tokens.append('"$__fleetctl_payload"')
    argv_tokens.extend(shlex.quote(arg) for arg in script_args)
    return [
        "umask 077",
        '__fleetctl_payload="$(mktemp "${TMPDIR:-/tmp}/fleetctl-payload.XXXXXX")"',
        'chmod 700 "$__fleetctl_payload"',
        "trap 'rm -f \"$__fleetctl_payload\"' EXIT",
        "trap 'exit 129' HUP",
        "trap 'exit 130' INT",
        "trap 'exit 143' TERM",
        f"base64 -d > \"$__fleetctl_payload\" <<'{delimiter}'",
        *body,
        delimiter,
        " ".join(argv_tokens),
        "exit $?",
    ]


def render_slurm_wrapper(
    *,
    protocol: ProtocolRecord,
    remote_script: str,
    script_args: list[str],
    interpreter: str | None,
    environment: dict[str, str],
    cwd: str | None,
    queue: QueueRecord,
    job_name: str,
    time_limit: str | None,
    gpus: int | None,
    cpus_per_task: int | None,
    mem: str | None,
    output_path: str | None,
    error_path: str | None,
    account: str | None = None,
    qos: str | None = None,
    inline_payload: bytes | None = None,
) -> str:
    """Render a tiny Slurm wrapper for a staged script.

    ACCOUNT/QOS override the queue preset's own `account`/`qos` when given
    (`submit --account`/`--qos`) -- resolved here, once, so every reader of the
    rendered text (including preflight_gate's site-policy check, which lints
    this wrapper rather than the payload) sees the *effective* value rather
    than the preset's, with no separate plumbing required.

    INLINE_PAYLOAD, when given, embeds that payload directly in the wrapper
    (see render_inline_payload_lines) instead of referencing REMOTE_SCRIPT,
    which then goes unused; REMOTE_SCRIPT is still required so the two call
    sites (the real submit path and the preflight gate, which renders the
    wrapper before anything is staged) do not need to special-case which
    string to pass.
    """
    lines = [
        "#!/usr/bin/env bash",
        f"#SBATCH --job-name={job_name}",
        f"#SBATCH --partition={queue.partition}",
        "#SBATCH --ntasks=1",
    ]
    gpu_directive = slurm_gpu_directive(protocol, queue, gpus)
    if gpu_directive:
        lines.append(gpu_directive)
    resolved_time = time_limit or queue.time_limit
    if resolved_time:
        lines.append(f"#SBATCH --time={resolved_time}")
    resolved_cpus = cpus_per_task if cpus_per_task is not None else queue.cpus_per_task
    if resolved_cpus is not None:
        lines.append(f"#SBATCH --cpus-per-task={resolved_cpus}")
    resolved_mem = mem or queue.mem
    if resolved_mem:
        lines.append(f"#SBATCH --mem={resolved_mem}")
    resolved_account = account or queue.account
    if resolved_account:
        lines.append(f"#SBATCH --account={resolved_account}")
    resolved_qos = qos or queue.qos
    if resolved_qos:
        lines.append(f"#SBATCH --qos={resolved_qos}")
    if queue.constraint:
        lines.append(f"#SBATCH --constraint={queue.constraint}")
    if output_path:
        lines.append(f"#SBATCH --output={output_path}")
    if error_path:
        lines.append(f"#SBATCH --error={error_path}")
    for directive in queue.extra_directives:
        lines.append(f"#SBATCH {directive}")
    # A line break inside any value would end its #SBATCH line and start
    # another directive that sbatch obeys, so refuse rather than render it.
    for line in lines:
        if line.startswith("#SBATCH") and any(char in line for char in "\r\n\0"):
            name = line.split("=", 1)[0].removeprefix("#SBATCH ")
            raise FleetError(
                f"`{name}` contains a line break; sbatch would read the rest as "
                "new directives"
            )
    lines.extend(
        [
            "",
            "set -euo pipefail",
        ]
    )
    if cwd:
        # quote_remote_path, not a bare shlex.quote: the latter would quote a
        # leading `~/` into inert literal text that no shell ever expands, so
        # every `~`-relative workdir failed here with "no such file or
        # directory" (remote_shell_command hit the same bug and was fixed the
        # same way).
        lines.append(f"cd {quote_remote_path(cwd)}")
    for key, value in sorted(environment.items()):
        lines.append(f"export {key}={shlex.quote(value)}")
    if inline_payload is not None:
        lines.extend(
            render_inline_payload_lines(
                inline_payload, interpreter=interpreter, script_args=script_args
            )
        )
    else:
        argv: list[str] = []
        if interpreter:
            argv.extend(shlex.split(interpreter))
        argv.append(remote_script)
        argv.extend(script_args)
        lines.append(shlex.join(argv))
    return "\n".join(lines) + "\n"


def target_display(
    target: TargetRecord,
    *,
    protocol_name: str,
    role: str,
    pool_names: Iterable[str] = (),
) -> dict[str, Any]:
    """Render one target for table or JSON output."""
    return {
        "name": target.name,
        "protocol": protocol_name,
        "reach": list(target.reach),
        "workdir": target.workdir or "",
        "enabled": target.enabled,
        "tags": list(target.tags),
        "default_profile": target.default_profile or "",
        "role": role,
        "pools": sorted(pool_names),
        "capabilities": dict(target.capabilities),
    }


def protocol_display(protocol: ProtocolRecord) -> dict[str, Any]:
    """Render one protocol as structured data."""
    default_queue = protocol.default_queue()
    return {
        "name": protocol.name,
        "kind": protocol.kind,
        "description": protocol.description or "",
        "default_profile": protocol.default_profile or "",
        "default_queue": default_queue.name if default_queue is not None else "",
        "gpu_request_mode": protocol.gpu_request_mode,
        "native_batch_required": protocol.native_batch_required,
        "job_output_dir": protocol.job_output_dir,
        "gpu_vendor": protocol.gpu_vendor or "",
        "preferred_storage": protocol.preferred_storage or "",
        "home_prefix": protocol.home_prefix or "",
        "storage_caveat": protocol.storage_caveat or "",
        "rule_prefix": protocol.rule_prefix or "",
        "docs": list(protocol.docs),
        "notes": list(protocol.notes),
        "queues": [queue_display(queue) for queue in protocol.queues],
    }


def queue_display(queue: QueueRecord) -> dict[str, Any]:
    """Render one queue preset."""
    return {
        "name": queue.name,
        "partition": queue.partition,
        "default": queue.default,
        "gpus": queue.gpus if queue.gpus is not None else "",
        "cpus_per_task": (
            queue.cpus_per_task if queue.cpus_per_task is not None else ""
        ),
        "mem": queue.mem or "",
        "time_limit": queue.time_limit or "",
        "gres": queue.gres or "",
        "account": queue.account or "",
        "qos": queue.qos or "",
        "constraint": queue.constraint or "",
        "max_time": queue.max_time or "",
        "allowed_accounts": list(queue.allowed_accounts),
        "denied_accounts": list(queue.denied_accounts),
        "required_qos": queue.required_qos or "",
        "account_required": queue.account_required,
        "gres_types": list(queue.gres_types),
        "gpu_only": queue.gpu_only,
        "nodes": list(queue.nodes),
        "evidence": queue.evidence or "",
        "as_of": queue.as_of or "",
        "extra_directives": list(queue.extra_directives),
        "notes": list(queue.notes),
        "capabilities": dict(queue.capabilities),
    }


def redact_secret(secret: FleetSecret) -> dict[str, Any]:
    """Produce a safe secret preview.

    The username used to come back verbatim next to a `<redacted>` host, which is
    half a credential and most of the way to the other half.  What is left is
    what you actually debug with: whether an identity is configured, which port,
    and whether a password is on file.
    """
    return {
        "host": "<redacted>",
        "user": "<redacted>",
        "port": secret.port,
        "auth": secret.auth,
        "identity_file": secret.identity_file or "",
        "password_configured": secret.password is not None,
    }


def emit(payload: dict[str, Any], *, as_json: bool) -> None:
    """Print one command result: JSON when asked, aligned key/value lines otherwise.

    Every command used to carry its own printer, and two of them shipped an
    `if args.json:` whose branches were character-identical -- so `doctor`
    emitted JSON whether or not you asked for it.
    """
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print(render_text_payload(payload))


def emit_rows(
    rows: list[dict[str, Any]],
    columns: list[str],
    *,
    as_json: bool,
    when_empty: str | None = None,
) -> None:
    """Print a list of records: JSON when asked, one fixed-width table otherwise.

    `when_empty` names the case where having nothing to show is itself the
    problem.  It applies to the table only -- an empty JSON list is a complete
    and correct answer, and a caller piping `--json` into another program should
    not have to catch an error to learn that a protocol has no queues.
    """
    if as_json:
        print(json.dumps(rows, indent=2, sort_keys=True))
        return
    if not rows and when_empty is not None:
        raise FleetError(when_empty)
    print(format_table(rows, columns))


def render_text_payload(value: Any, *, indent: int = 0) -> str:
    """Render nested plain data as readable indented lines."""
    pad = "  " * indent
    if isinstance(value, dict):
        if not value:
            return f"{pad}(none)"
        width = max(len(str(key)) for key in value)
        lines: list[str] = []
        for key, item in value.items():
            label = f"{pad}{str(key).ljust(width)}"
            if isinstance(item, (dict, list, tuple)) and item:
                lines.append(f"{label} :")
                lines.append(render_text_payload(item, indent=indent + 1))
            else:
                lines.append(f"{label} : {render_scalar(item)}")
        return "\n".join(lines)
    if isinstance(value, (list, tuple)):
        if not value:
            return f"{pad}(none)"
        parts = [
            render_text_payload(item, indent=indent)
            if isinstance(item, (dict, list, tuple))
            else f"{pad}- {render_scalar(item)}"
            for item in value
        ]
        separator = "\n\n" if any(isinstance(item, dict) for item in value) else "\n"
        return separator.join(parts)
    return f"{pad}{render_scalar(value)}"


def render_scalar(value: Any) -> str:
    """Render one leaf value for human output."""
    if value is None:
        return "-"
    if isinstance(value, (dict, list, tuple)) and not value:
        return "(none)"
    if value == "":
        return "-"
    if value is True:
        return "yes"
    if value is False:
        return "no"
    return str(value)


def planned_script_path(profile: ProfileRecord, local_script: Path) -> str:
    """Return the shape of the path a script would be staged to, without staging it.

    The real token is drawn per run and a relative `remote_script_root` needs the
    remote home resolved, so a dry run shows the shape rather than pretending to
    know the exact path.  Nothing else about the command depends on it.
    """
    root = profile.remote_script_root
    if not root.startswith(("/", "~/", "$HOME")):
        # What the real staging does, minus the round trip that resolves $HOME.
        root = f"$HOME/{root}"
    return remote_posix_join(remote_posix_join(root, "<token>"), local_script.name)


def report_plan(
    plan: Plan,
    args: argparse.Namespace,
    extra: dict[str, Any] | None = None,
    *,
    block: tuple[str, str] | None = None,
) -> int:
    """Print the resolved plan and do nothing else.

    Ansible's honesty rule: this simulates local resolution and claims nothing
    about remote state.  `sync` is the one verb where a dry run can be
    remote-accurate, and it runs `rsync --dry-run` itself to earn that.
    """
    payload = plan.describe()
    payload["ssh"] = shlex.join(plan.ssh_connect_argv())
    payload.update(extra or {})
    as_json = bool(getattr(args, "json", False))
    if block is not None and as_json:
        payload[block[0]] = block[1]
    emit(payload, as_json=as_json)
    if block is not None and not as_json:
        print(f"\n--- {block[0]} ---")
        print(block[1].rstrip("\n"))
    return 0


def report_script_plan(
    plan: Plan,
    args: argparse.Namespace,
    local_script: Path,
    *,
    interpreter: str | None,
    script_args: list[str],
) -> int:
    """Describe the script run PLAN would perform."""
    chosen = interpreter or plan.profile.interpreter
    staged = planned_script_path(plan.profile, local_script)
    argv: list[str] = []
    if chosen:
        argv.extend(shlex.split(chosen))
    argv.append(staged)
    argv.extend(script_args)
    return report_plan(
        plan,
        args,
        {
            "local_script": str(local_script),
            "staged_as": staged,
            "interpreter": chosen,
            "remote_command": shlex.join(
                prefixed_env_command(argv, plan.profile.environment)
            ),
        },
    )


def format_table(rows: list[dict[str, Any]], columns: list[str]) -> str:
    """Render a tiny fixed-width table."""
    def cell(value: Any) -> str:
        if isinstance(value, (list, tuple)):
            return ",".join(str(item) for item in value)
        return str(value)

    widths = {column: len(column) for column in columns}
    for row in rows:
        for column in columns:
            widths[column] = max(widths[column], len(cell(row.get(column, ""))))
    header = "  ".join(column.ljust(widths[column]) for column in columns)
    body = [
        "  ".join(cell(row.get(column, "")).ljust(widths[column]) for column in columns)
        for row in rows
    ]
    return "\n".join([header, *body])


def serialize_projects(projects: list[ProjectBinding]) -> str:
    """Serialize project bindings without third-party TOML dependencies."""
    lines = ['version = 1', ""]
    for item in sorted(projects, key=lambda binding: str(binding.path)):
        lines += [
            "[[project]]",
            f"path = {toml_string(str(item.path))}",
        ]
        if item.default_target:
            lines.append(f"default_target = {toml_string(item.default_target)}")
        if item.default_pool:
            lines.append(f"default_pool = {toml_string(item.default_pool)}")
        if item.default_profile:
            lines.append(f"default_profile = {toml_string(item.default_profile)}")
        if item.remote_root:
            lines.append(f"remote_root = {toml_string(item.remote_root)}")
        for target_name, remote_root in sorted(item.remote_roots_by_target.items()):
            lines += [
                "",
                "[[project.target_root]]",
                f"target = {toml_string(target_name)}",
                f"remote_root = {toml_string(remote_root)}",
            ]
        if item.sync_excludes:
            quoted = ", ".join(toml_string(entry) for entry in item.sync_excludes)
            lines.append(f"sync_excludes = [{quoted}]")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


